---
import Layout from '../layouts/Layout.astro';
import products from '../data/products.json';
---

<Layout title="TOYFACTORY | Premium B2B Toy Manufacturer | OEM/ODM">
	<!-- Navbar -->
	<nav class="fixed w-full z-50 bg-dark/90 backdrop-blur-lg border-b border-white/5">
		<div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
			<div class="text-2xl font-display font-extrabold tracking-tighter text-white">
				TOY<span class="text-gold">FACTORY</span>
			</div>
			<div class="hidden lg:flex gap-10 text-[11px] font-bold uppercase tracking-[0.2em] text-gray-400">
				<a href="#products" class="hover:text-gold transition">Catalog</a>
				<a href="#" class="hover:text-gold transition">Manufacturing</a>
				<a href="#" class="hover:text-gold transition">Certificates</a>
				<a href="#" class="hover:text-gold transition">Contact</a>
			</div>
			<a href="#rfq" class="bg-gold text-dark px-8 py-3.5 font-bold text-xs uppercase tracking-widest hover:bg-white transition-all duration-300">
				Get a Quote
			</a>
		</div>
	</nav>

	<main>
		<!-- Hero Section -->
		<section class="relative min-h-screen flex items-center overflow-hidden">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 bg-gradient-to-b from-dark/60 via-dark to-dark z-10"></div>
				<img src="https://images.unsplash.com/photo-1532330393533-443990a51d10?auto=format&fit=crop&q=80&w=1920" class="w-full h-full object-cover scale-105" alt="Factory Hero" />
			</div>
			
			<div class="relative z-20 max-w-7xl mx-auto px-6 w-full pt-20">
				<div class="max-w-3xl">
					<div class="inline-block border border-gold/30 px-4 py-1.5 rounded-full mb-8">
						<span class="text-[10px] font-bold uppercase tracking-[0.3em] text-gold">Factory Direct OEM/ODM</span>
					</div>
					<h1 class="text-6xl md:text-8xl font-display font-extrabold leading-[0.9] mb-8 uppercase tracking-tighter">
						Crafting <span class="text-gold">Next-Gen</span> Play.
					</h1>
					<p class="text-lg md:text-xl text-gray-400 mb-12 max-w-xl leading-relaxed font-light">
						Professional manufacturing for global toy brands. High-precision production, certified quality, and reliable lead times.
					</p>
					<div class="flex flex-col sm:flex-row gap-6">
						<a href="#products" class="bg-white text-dark px-10 py-5 font-bold uppercase text-xs tracking-widest hover:bg-gold transition-all duration-500 text-center">
							Explore Catalog
						</a>
						<div class="flex items-center gap-8 px-8 border-l border-white/10 hidden sm:flex">
							<div class="text-center">
								<div class="text-2xl font-bold font-display">15+</div>
								<div class="text-[9px] uppercase tracking-widest text-gray-500">Days Lead Time</div>
							</div>
							<div class="text-center">
								<div class="text-2xl font-bold font-display">ISO</div>
								<div class="text-[9px] uppercase tracking-widest text-gray-500">9001 Certified</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Features Bar -->
		<section class="border-y border-white/5 bg-card/30 py-10">
			<div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8">
				{['Global Shipping', 'Fast Sampling', 'Custom Packaging', 'Wholesale Pricing'].map(f => (
					<div class="text-center">
						<span class="text-[10px] font-bold uppercase tracking-[0.2em] text-gray-500">{f}</span>
					</div>
				))}
			</div>
		</section>

		<!-- Products Section -->
		<section id="products" class="py-32 px-6">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-24">
					<h2 class="text-xs font-bold text-gold uppercase tracking-[0.5em] mb-4">Export Catalog</h2>
					<h3 class="text-4xl md:text-5xl font-display font-extrabold uppercase tracking-tight">Featured Collections</h3>
					<div class="w-12 h-1 bg-gold mx-auto mt-8"></div>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8">
					{products.map((product) => (
						<a href={`/product/${product.id}`} class="group bg-card border border-white/5 hover:border-gold/30 transition-all duration-500 block overflow-hidden">
							<div class="aspect-square overflow-hidden bg-white/5 flex items-center justify-center p-8">
								<img 
									src={product.image} 
									alt={product.name} 
									class="max-w-full max-h-full object-contain group-hover:scale-110 transition duration-700 opacity-90 group-hover:opacity-100"
									loading="lazy"
								/>
							</div>
							<div class="p-8 border-t border-white/5">
								<div class="flex justify-between items-start mb-4">
									<span class="text-[9px] font-bold text-gold uppercase tracking-widest">{product.id}</span>
									<span class="text-[10px] text-gray-500 uppercase">MOQ: {product.moq}</span>
								</div>
								<h4 class="text-md font-bold text-white mb-6 uppercase tracking-tight line-clamp-1 group-hover:text-gold transition">{product.name}</h4>
								<div class="flex justify-between items-center">
									<span class="text-sm font-light text-gray-400">Wholesale:</span>
									<span class="text-lg font-bold font-display">${product.price}+</span>
								</div>
								<div class="mt-8 py-3 border border-white/10 text-center text-[9px] font-bold uppercase tracking-[0.2em] group-hover:bg-gold group-hover:text-dark transition-all duration-300">
									View Details
								</div>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- RFQ Banner -->
		<section id="rfq" class="py-32 bg-gold text-dark">
			<div class="max-w-4xl mx-auto px-6 text-center">
				<h2 class="text-5xl md:text-6xl font-display font-extrabold mb-8 uppercase tracking-tighter italic">Ready to Scale?</h2>
				<p class="text-lg mb-12 font-medium opacity-80 uppercase tracking-widest">Connect with our production team for a personalized volume quote.</p>
				<div class="flex flex-col sm:flex-row justify-center gap-6">
					<a href="https://wa.me/861349669150" target="_blank" class="bg-dark text-white px-12 py-6 font-bold uppercase text-xs tracking-[0.2em] hover:bg-white hover:text-dark transition-all duration-300">
						WhatsApp Inquiry
					</a>
					<a href="mailto:contact@toyfactory.global" class="border-2 border-dark text-dark px-12 py-6 font-bold uppercase text-xs tracking-[0.2em] hover:bg-dark hover:text-white transition-all duration-300">
						Send Email
					</a>
				</div>
			</div>
		</section>
	</main>

	<!-- Footer -->
	<footer class="py-20 border-t border-white/5 bg-dark">
		<div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-16">
			<div>
				<div class="text-xl font-display font-extrabold tracking-tighter text-white mb-8">
					TOY<span class="text-gold">FACTORY</span>
				</div>
				<p class="text-xs text-gray-500 leading-loose uppercase tracking-widest">
					Premium toy manufacturing solutions for the global market. 
					ISO 9001 certified facility based in China.
				</p>
			</div>
			<div class="flex flex-col gap-4 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">
				<a href="#" class="hover:text-gold">Terms of Service</a>
				<a href="#" class="hover:text-gold">Privacy Policy</a>
				<a href="#" class="hover:text-gold">Export Documentation</a>
			</div>
			<div class="text-[10px] text-gray-600 uppercase tracking-widest leading-loose">
				&copy; 2026 TOYFACTORY Manufacturing.<br/>
				All manufacturing assets are proprietary.
			</div>
		</div>
	</footer>

	<!-- WhatsApp Float -->
	<a href="https://wa.me/861349669150" target="_blank" class="fixed bottom-10 right-10 bg-[#25D366] p-5 rounded-full shadow-[0_20px_50px_rgba(37,211,102,0.3)] hover:scale-110 transition-all duration-500 z-50 group">
		<svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
	</a>
</Layout>
