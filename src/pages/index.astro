---
import Layout from '../layouts/Layout.astro';
import products from '../data/products.json';

const categories = [
  {
    id: 'Track Toys',
    title: 'Precision Track Systems',
    desc: 'Advanced orbital and magnetic track toys for educational development.',
    banner: '/images/cat-track.png'
  },
  {
    id: 'Bubble Toys',
    title: 'Magic Bubble Machines',
    desc: 'High-output automatic bubble machines and wands for summer fun.',
    banner: '/images/cat-bubble.png'
  },
  {
    id: 'Educational Toys',
    title: 'Educational & DIY',
    desc: 'STEM-focused toys, pottery machines, and creative learning tools.',
    banner: '/images/cat-edu.png'
  },
  {
    id: 'Water Guns',
    title: 'Power Water Blast',
    desc: 'Automatic and high-capacity electric water guns for professional export.',
    banner: '/images/cat-water.png'
  }
];

const getProductsByCategory = (catId) => products.filter(p => p.category === catId);
---

<Layout title="TOYFACTORY | Premium B2B Toy Manufacturer | Global Export">
	<!-- Navbar -->
	<nav class="fixed w-full z-50 bg-[#0A0A0F]/90 backdrop-blur-xl border-b border-white/5">
		<div class="max-w-[1600px] mx-auto px-8 h-24 flex items-center justify-between">
			<div class="text-2xl font-display font-extrabold tracking-tighter text-white">
				TOY<span class="text-gold">FACTORY</span>
			</div>
			<div class="hidden xl:flex gap-12 text-[11px] font-bold uppercase tracking-[0.2em] text-gray-400">
				<a href="/" class="hover:text-gold transition-colors text-white">Home</a>
				<div class="relative group cursor-pointer">
					<div class="flex items-center gap-1 hover:text-gold transition-colors">
						Products
						<svg class="w-3 h-3 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
					</div>
					<div class="absolute top-full left-1/2 -translate-x-1/2 w-64 bg-[#0A0A0F] border border-white/10 p-6 hidden group-hover:flex flex-col gap-4 shadow-2xl backdrop-blur-xl">
						{categories.map(cat => (
							<a href={`#${cat.id.replace(/\s+/g, '-').toLowerCase()}`} class="hover:text-gold transition-colors text-xs whitespace-nowrap">{cat.id}</a>
						))}
					</div>
				</div>
				<a href="#rfq" class="hover:text-gold transition-colors">Contacts</a>
			</div>
			<div class="flex items-center gap-8">
				<a href="https://wa.me/8615976917707" target="_blank" class="hidden sm:flex items-center gap-2 text-green-500 font-bold text-[10px] uppercase tracking-widest">
					<span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
					Online Support
				</a>
				<a href="#rfq" class="bg-gold text-dark px-8 py-4 font-bold uppercase text-[10px] tracking-widest hover:bg-white transition-all duration-300">
					Start RFQ
				</a>
			</div>
		</div>
	</nav>

	<main>
		<!-- Hero Section -->
		<section class="relative h-screen flex items-center overflow-hidden">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 bg-gradient-to-r from-black via-black/40 to-transparent z-10"></div>
				<img src="/images/hero-factory.png" class="w-full h-full object-cover object-top" alt="Huanuo Toy Factory" />
			</div>
			
			<div class="relative z-20 max-w-[1600px] mx-auto px-8 w-full">
				<div class="max-w-3xl -left-12 relative">
					<div class="flex gap-4 mb-8">
						<span class="w-12 h-[2px] bg-gold self-center"></span>
						<span class="text-gold font-bold text-xs uppercase tracking-[0.6em]">Premium OEM/ODM Manufacturing</span>
					</div>
					<h1 class="text-7xl md:text-9xl font-display font-extrabold text-white mb-10 leading-[0.85] tracking-tighter uppercase italic">
						Scale Your<br/><span class="text-gold">Toy Brand.</span>
					</h1>
					<p class="text-gray-300 text-lg uppercase tracking-[0.2em] mb-12 max-w-xl font-light leading-relaxed">
						High-capacity industrial production for global distributors. Precision, Compliance, and Market-Ready Excellence.
					</p>
					<div class="flex flex-col sm:flex-row gap-8">
						<a href="#products-start" class="bg-gold text-dark px-14 py-7 font-bold uppercase text-[10px] tracking-[0.3em] hover:bg-white transition-all duration-300 text-center">
							Explore Collections
						</a>
						<a href="https://wa.me/8615976917707" target="_blank" class="border-2 border-white/20 text-white px-14 py-7 font-bold uppercase text-[10px] tracking-[0.3em] hover:bg-white hover:text-dark transition-all duration-300 text-center">
							Contact Factory
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Factory Profile Section -->
		<section class="py-40 bg-[#0D0D12]">
			<div class="max-w-[1600px] mx-auto px-8">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
					<div>
						<h2 class="text-5xl md:text-7xl font-display font-extrabold uppercase tracking-tighter text-white mb-10 italic">Our<br/><span class="text-gold">Heritage.</span></h2>
						<div class="flex gap-4 mb-10">
							<span class="px-4 py-2 bg-gold/10 border border-gold/20 text-gold text-[10px] font-bold uppercase tracking-widest">Est. 2006</span>
							<span class="px-4 py-2 bg-gold/10 border border-gold/20 text-gold text-[10px] font-bold uppercase tracking-widest">Chenghai Base</span>
							<span class="px-4 py-2 bg-gold/10 border border-gold/20 text-gold text-[10px] font-bold uppercase tracking-widest">OEM/ODM Expert</span>
						</div>
					</div>
					<div class="space-y-8">
						<p class="text-gray-300 text-lg leading-[1.8] font-light">
							Established in 2006 and located in Chenghai, Guangdong Province, which is famous as the Toys & Gifts Production Base in China. We are a professional China toys manufacturer and exporter offering excellent OEM/ODM service to global famous brands.
						</p>
						<p class="text-gray-400 text-sm leading-[2] uppercase tracking-wide">
							The factory covers more than 5000m², passing audits such as GMPC, ISO 22716, GSV, BSCI, and SEDEX. We specialize in high-quality toy production across multiple categories including beauty sets, STEM learning, water guns, and bubble toys. Providing the best quality goods and wonderful services for clients is our principle. No matter how your order quantity is, our professional staff will provide sincere and enthusiastic service.
						</p>
						<div class="grid grid-cols-2 md:grid-cols-3 gap-8 pt-8">
							{['EN-71', 'ASTM', 'BSCI', 'ISO 22716', 'GSV', 'SEDEX'].map(cert => (
								<div class="border border-white/5 p-6 text-center hover:border-gold/30 transition-colors group">
									<div class="text-white font-bold text-xs uppercase tracking-widest group-hover:text-gold transition-colors">{cert}</div>
								</div>
							))}
						</div>
					</div>
				</div>
			</div>
		</section>

		<div id="products-start"></div>

		<!-- Category Sections -->
		{categories.map((cat, index) => (
			<section id={cat.id.replace(/\s+/g, '-').toLowerCase()} class="pb-32">
				<!-- Category Poster -->
				<div class="relative h-[50vh] flex items-center overflow-hidden mb-20 border-y border-white/5">
					<!-- Minimal overlay for text readability -->
					<div class="absolute inset-0 bg-black/20 z-10"></div>
					<img src={cat.banner} class="w-full h-full object-cover" alt={cat.title} />
					<div class="relative z-20 max-w-[1600px] mx-auto px-8 w-full text-center">
						<span class="text-gold font-bold text-xs uppercase tracking-[0.5em] mb-6 block drop-shadow-md">Collection {index + 1}</span>
						<h2 class="text-5xl md:text-7xl font-display font-extrabold uppercase tracking-tighter text-white mb-6 italic drop-shadow-[0_4px_4px_rgba(0,0,0,0.8)]">
							{cat.title === "Water Guns" ? "Power Water GUN" : cat.title}
						</h2>
						<p class="max-w-2xl mx-auto text-gray-100 uppercase text-[10px] tracking-[0.3em] font-bold drop-shadow-md">{cat.desc}</p>
					</div>
				</div>

				<!-- Product Grid -->
				<div class="max-w-[1600px] mx-auto px-8">
					<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8">
						{getProductsByCategory(cat.id).slice(0, 8).map(product => (
							<a href={`/product/${product.id}`} target="_blank" class="group bg-[#15151A] border border-white/5 hover:border-gold/30 transition-all duration-700 flex flex-col">
								<div class="aspect-square overflow-hidden bg-white/5 flex items-center justify-center p-12">
									<img 
										src={product.images[0]} 
										alt={product.name} 
										class="w-full h-full object-contain group-hover:scale-110 transition duration-1000"
										loading="lazy"
									/>
								</div>
								<div class="p-6 flex-grow flex flex-col">
									<div class="flex items-center gap-3 mb-2">
										<span class="bg-gold/10 text-gold text-[8px] font-bold px-2 py-0.5 uppercase tracking-widest border border-gold/20 italic">Bestseller</span>
										<span class="text-[8px] font-bold text-gray-500 uppercase tracking-widest">{product.id}</span>
									</div>
									<h4 class="text-lg font-bold text-white mb-4 uppercase tracking-tight leading-tight group-hover:text-gold transition line-clamp-2">{product.name}</h4>
									
									<div class="mt-auto">
										<div class="grid grid-cols-2 gap-4 border-y border-white/5 py-4 mb-4">
											<div>
												<div class="text-[8px] uppercase text-gray-600 tracking-widest mb-0.5">Min Order</div>
												<div class="text-[10px] font-bold text-gray-300">{product.moq} PCS</div>
											</div>
											<div>
												<div class="text-[8px] uppercase text-gray-600 tracking-widest mb-0.5">Lead Time</div>
												<div class="text-[10px] font-bold text-gray-300">10-15 Days</div>
											</div>
										</div>
										<div class="flex justify-between items-end">
											<div class="text-[8px] font-bold uppercase tracking-widest text-white">Wholesale Price</div>
											<div class="text-2xl font-display font-extrabold text-gold">${product.price}+</div>
										</div>
										<div class="mt-6 w-full py-4 border border-white/10 text-center text-[9px] font-bold uppercase tracking-[0.3em] group-hover:bg-gold group-hover:text-dark transition-all duration-500 group-hover:border-gold italic">
											&rarr; Quote This Product
										</div>
									</div>
								</div>
							</a>
						))}
					</div>
				</div>
			</section>
		))}

		<!-- Quote Section -->
		<section id="rfq" class="py-40 bg-gold text-dark relative overflow-hidden">
			<div class="absolute right-[-10%] top-[-10%] text-[20vw] font-display font-extrabold opacity-5 tracking-tighter select-none">FACTORY</div>
			<div class="max-w-[1600px] mx-auto px-8 relative z-10">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-32 items-center">
					<div>
						<h2 class="text-7xl md:text-8xl font-display font-extrabold mb-10 uppercase tracking-tighter leading-[0.85] italic">Ready for<br/>Production?</h2>
						<p class="text-xl mb-14 font-medium opacity-80 uppercase tracking-[0.2em] max-w-lg leading-relaxed">
							Our engineering team is ready to transform your vision into market-leading products. 
						</p>
						<div class="flex flex-col sm:flex-row gap-8">
							<a href="https://wa.me/8615976917707" target="_blank" class="bg-dark text-white px-14 py-7 font-bold uppercase text-[10px] tracking-[0.3em] hover:scale-105 transition-all duration-300 text-center">
								WhatsApp Support
							</a>
							<a href="mailto:hntoys7@sinuotoys.com" class="border-2 border-dark text-dark px-14 py-7 font-bold uppercase text-[10px] tracking-[0.3em] hover:bg-dark hover:text-white transition-all duration-300 text-center">
								Email Proposal
							</a>
						</div>
					</div>
					<div class="bg-dark p-16 border border-dark/20">
						<h3 class="text-white text-3xl font-display font-bold uppercase mb-10 tracking-tight italic">Quick RFQ</h3>
						<form action="https://formspree.io/f/mkoyapvg" method="POST" id="rfq-form-v2" class="grid grid-cols-1 gap-10">
							<input type="text" name="company" placeholder="COMPANY NAME" required style="text-transform: none !important; -webkit-text-transform: none !important;" class="bg-transparent border-b border-white/20 p-4 text-white text-xs tracking-widest focus:border-gold outline-none placeholder:text-gray-700">
							<input type="email" name="email" placeholder="BUSINESS EMAIL" required style="text-transform: none !important; -webkit-text-transform: none !important;" class="bg-transparent border-b border-white/20 p-4 text-white text-xs tracking-widest focus:border-gold outline-none placeholder:text-gray-700">
							<textarea name="message" placeholder="PROJECT DETAILS" rows="3" required style="text-transform: none !important; -webkit-text-transform: none !important;" class="bg-transparent border-b border-white/20 p-4 text-white text-xs tracking-widest focus:border-gold outline-none placeholder:text-gray-700"></textarea>
							<button type="submit" class="bg-gold text-dark font-extrabold py-6 uppercase tracking-[0.4em] text-[10px] hover:bg-white transition-all duration-500">
								Submit Project Inquiry
							</button>
						</form>
					</div>
				</div>
			</div>
		</section>
	</main>

	<!-- Footer -->
	<footer class="py-32 border-t border-white/5 bg-[#050508]">
		<div class="max-w-[1600px] mx-auto px-8">
			<div class="grid grid-cols-1 md:grid-cols-4 gap-24 mb-24">
				<div class="col-span-1 md:col-span-2">
					<div class="text-3xl font-display font-extrabold tracking-tighter text-white mb-10">
						TOY<span class="text-gold">FACTORY</span>
					</div>
					<p class="text-[11px] text-gray-500 leading-[2.5] uppercase tracking-[0.2em] max-w-md">
						Elite manufacturing infrastructure specializing in high-demand toy export. 
						Precision engineering and global distribution standards. 
						ISO 9001:2015 Certified Facility.
					</p>
				</div>
				<div>
					<h5 class="text-white text-[10px] font-bold uppercase tracking-[0.4em] mb-10">Capabilities</h5>
					<div class="flex flex-col gap-6 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-600">
						<a href="#" class="hover:text-gold transition">Private Label</a>
						<a href="#" class="hover:text-gold transition">Custom Molding</a>
						<a href="#" class="hover:text-gold transition">Fast Prototyping</a>
						<a href="#" class="hover:text-gold transition">Logistics Support</a>
					</div>
				</div>
				<div>
					<h5 class="text-white text-[10px] font-bold uppercase tracking-[0.4em] mb-10">Resources</h5>
					<div class="flex flex-col gap-6 text-[10px] font-bold uppercase tracking-[0.2em]">
						<div class="flex flex-col gap-3">
							<span class="text-gold text-xs">Direct Factory Contact</span>
							<div class="flex flex-col gap-1">
								<p class="text-white text-sm normal-case tracking-tight font-medium">WhatsApp / WeChat / Tel: <span class="text-gold">+86 15976917707</span></p>
								<p class="text-white text-sm normal-case tracking-tight font-medium">Email: <span class="text-gold">hntoys7@sinuotoys.com</span></p>
							</div>
						</div>
						<div class="flex flex-col gap-4 text-gray-500">
							<a href="#" class="hover:text-gold transition">Compliance</a>
							<a href="#" class="hover:text-gold transition">Case Studies</a>
						</div>
					</div>
				</div>
			</div>
			<div class="pt-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-8">
				<div class="text-[9px] text-gray-700 uppercase tracking-[0.4em]">
					&copy; 2026 TOYFACTORY Manufacturing Group.
				</div>
				<div class="flex gap-10 text-[9px] text-gray-700 uppercase tracking-[0.4em]">
					<a href="/privacy" class="hover:text-gold transition">Privacy</a>
					<a href="/terms" class="hover:text-gold transition">Terms</a>
					<a href="/return" class="hover:text-gold transition">Returns</a>
				</div>
			</div>
		</div>
	</footer>

	<!-- WhatsApp Float -->
	<a href="https://wa.me/8615976917707" target="_blank" class="fixed bottom-12 right-12 bg-[#25D366] p-6 rounded-full shadow-[0_30px_60px_rgba(37,211,102,0.4)] hover:scale-110 transition-all duration-500 z-50 group">
		<svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
	</a>
</Layout>
