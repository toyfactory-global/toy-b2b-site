---
import Layout from '../layouts/Layout.astro';
import products from '../data/products.json';
---

<Layout title="Premium Toy Manufacturer | Factory Direct B2B">
	<!-- Header -->
	<header class="fixed w-full z-50 bg-dark/80 backdrop-blur-md border-b border-white/10">
		<div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
			<div class="text-2xl font-display font-bold tracking-tighter">
				TOY<span class="text-gold">FACTORY</span>
			</div>
			<nav class="hidden md:flex gap-8 text-sm font-medium uppercase tracking-widest">
				<a href="#" class="hover:text-gold transition">Products</a>
				<a href="#" class="hover:text-gold transition">Factory</a>
				<a href="#" class="hover:text-gold transition">Certificates</a>
				<a href="#" class="hover:text-gold transition">Contact</a>
			</nav>
			<a href="#rfq" class="bg-gold text-dark px-6 py-2.5 font-bold text-sm rounded-sm hover:bg-white transition uppercase">
				Get Free Quote
			</a>
		</div>
	</header>

	<main>
		<!-- Hero Section -->
		<section class="relative h-screen flex items-center pt-20">
			<div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1532330393533-443990a51d10?auto=format&fit=crop&q=80&w=1920')] bg-cover bg-center opacity-40"></div>
			<div class="absolute inset-0 bg-gradient-to-r from-dark via-dark/80 to-transparent"></div>
			
			<div class="relative max-w-7xl mx-auto px-6">
				<div class="max-w-2xl">
					<h1 class="text-6xl md:text-8xl font-display font-bold leading-none mb-6">
						PREMIUM<br/><span class="text-gold">TOY OEM</span> SOLUTIONS
					</h1>
					<p class="text-xl text-gray-400 mb-10 leading-relaxed">
						Direct from factory. Precision manufacturing for global brands. 
						MOQ starts from 50pcs. ISO 9001 Certified.
					</p>
					<div class="flex flex-wrap gap-4">
						<a href="#products" class="border-2 border-gold text-gold px-8 py-4 font-bold uppercase hover:bg-gold hover:text-dark transition">
							View Catalog
						</a>
						<div class="flex items-center gap-4 px-6 border-l border-white/20">
							<div>
								<div class="text-2xl font-bold">15 Days</div>
								<div class="text-xs uppercase text-gray-500">Lead Time</div>
							</div>
							<div>
								<div class="text-2xl font-bold">Free</div>
								<div class="text-xs uppercase text-gray-500">Sampling</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Products Preview -->
		<section id="products" class="py-24 px-6">
			<div class="max-w-7xl mx-auto">
				<div class="flex justify-between items-end mb-16">
					<div>
						<h2 class="text-4xl font-display font-bold mb-4 uppercase">Featured Collections</h2>
						<p class="text-gray-500">Explore our latest high-demand product lines</p>
					</div>
					<a href="#" class="text-gold border-b border-gold pb-1 hover:text-white hover:border-white transition">Explore All</a>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{products.map((product) => (
						<a href={`/product/${product.id}`} class="bg-card group cursor-pointer border border-white/5 hover:border-gold/50 transition duration-500">
							<div class="aspect-square bg-dark overflow-hidden flex items-center justify-center">
								<img 
									src={product.image} 
									alt={product.name} 
									class="w-full h-full object-contain group-hover:scale-110 transition duration-700"
									onerror="this.src='https://placehold.co/800x800/1a1a1a/c9a84c?text=Product+Image'"
								/>
							</div>
							<div class="p-8">
								<div class="text-[10px] text-gold font-bold mb-2 uppercase tracking-widest">Item No: {product.id}</div>
								<h3 class="text-lg font-bold mb-4 line-clamp-1 uppercase">{product.name}</h3>
								<div class="flex justify-between items-center text-sm mb-6">
									<span class="text-gray-500">MOQ: {product.moq} pcs</span>
									<span class="text-white font-bold">${product.price}+</span>
								</div>
								<div class="w-full py-3 text-center border border-white/10 group-hover:bg-gold group-hover:text-dark group-hover:border-gold transition font-bold uppercase text-[10px] tracking-widest">
									View Specifications
								</div>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- RFQ Form Section -->
		<section id="rfq" class="py-24 bg-card border-t border-white/5">
			<div class="max-w-4xl mx-auto px-6">
				<div class="text-center mb-16">
					<h2 class="text-4xl font-display font-bold mb-4">START YOUR PROJECT</h2>
					<p class="text-gray-400">Get a custom quote within 24 hours from our manufacturing experts</p>
				</div>
				
				<form class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<input type="text" placeholder="Full Name" class="bg-dark border border-white/10 p-4 focus:border-gold outline-none">
					<input type="email" placeholder="Business Email" class="bg-dark border border-white/10 p-4 focus:border-gold outline-none">
					<select class="bg-dark border border-white/10 p-4 focus:border-gold outline-none col-span-full">
						<option>Select Category</option>
						<option>Action Figures</option>
						<option>Educational Toys</option>
						<option>Water & Outdoor</option>
					</select>
					<textarea placeholder="Tell us about your requirements (Quantity, Customization, etc.)" rows="4" class="bg-dark border border-white/10 p-4 focus:border-gold outline-none col-span-full"></textarea>
					<button class="bg-gold text-dark font-bold py-5 uppercase hover:bg-white transition col-span-full tracking-widest">
						Send Inquiry
					</button>
				</form>
			</div>
		</section>
	</main>

	<!-- Footer -->
	<footer class="py-12 border-t border-white/10 text-center text-gray-600 text-sm">
		<p>&copy; 2026 TOYFACTORY Manufacturing. All rights reserved.</p>
	</footer>

	<!-- WhatsApp Float -->
	<a href="https://wa.me/861349669150" target="_blank" class="fixed bottom-8 right-8 bg-green-500 p-4 rounded-full shadow-2xl hover:scale-110 transition z-50">
		<svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
	</a>
</Layout>
