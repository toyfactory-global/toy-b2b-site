---
import Layout from '../layouts/Layout.astro';

/**
 * WHY THIS FILE EXISTS
 * The product page RFQ form posts to Formspree with _next pointing here.
 * Someone who has just sent an inquiry is the most qualified visitor on the
 * site, so the page gives them three concrete next actions instead of a
 * dead-end "thank you".
 *
 * noindex: a confirmation page has no search value and would compete with
 * the real pages if it were indexed.
 */
const steps = [
  {
    label: 'Step 01',
    title: 'Browse the full catalogue',
    body: '41 models across four collections, each with its MOQ, unit price and carton loading published. Useful if the item you asked about is not the only one you need.',
    href: '/products',
    cta: 'Open the catalogue',
  },
  {
    label: 'Step 02',
    title: 'Talk to us on WhatsApp',
    body: 'Fastest route for a quote change, an artwork question or a sample request. Your item number is pre-filled in the message.',
    href: 'https://api.whatsapp.com/send/?phone=8615976917707&text=Hello%20TOYFACTORY%2C%20I%20have%20just%20sent%20an%20inquiry%20through%20your%20website.',
    cta: 'Open WhatsApp',
    external: true,
  },
  {
    label: 'Step 03',
    title: 'Read the buying guides',
    body: 'How this category is specified, certified, packed and shipped, written from the factory side rather than the trading company side.',
    href: '/blog',
    cta: 'Read the guides',
  },
];
---

<Layout
  title="Inquiry Received | TOYFACTORY Wholesale"
  description="Your inquiry has been received. TOYFACTORY replies to wholesale inquiries within one business day."
  noindex
>
  <nav class="bg-dark/95 border-b border-white/5 py-6 sticky top-0 z-50 backdrop-blur-md">
    <div class="max-w-[1600px] mx-auto px-8 flex items-center justify-between">
      <a href="/" class="text-xl font-display font-extrabold tracking-tighter hover:text-gold transition">
        TOY<span class="text-gold">FACTORY</span>
      </a>
      <a href="/products" class="text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:text-white transition flex items-center gap-2">
        <span>&larr;</span> BACK TO CATALOG
      </a>
    </div>
  </nav>

  <main class="py-24 md:py-32 px-8 bg-[#0A0A0F] min-h-screen">
    <div class="max-w-[1200px] mx-auto">
      <div class="flex items-center gap-6 mb-6">
        <span class="w-12 h-[2px] bg-gold self-center"></span>
        <span class="text-gold font-bold text-[9px] uppercase tracking-[0.5em]">Inquiry Received</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-display font-extrabold uppercase tracking-tighter italic mb-8 max-w-3xl">
        Thank you. Your inquiry is with our engineering team.
      </h1>
      <p class="text-gray-400 text-base leading-[1.9] max-w-2xl mb-6">
        We reply to wholesale inquiries within one business day, usually with the questions that let us price accurately rather than a generic PDF. If your requirement is urgent, WhatsApp is the fastest channel.
      </p>
      <p class="text-gray-500 text-sm leading-[1.8] max-w-2xl mb-20">
        If you do not see a reply, check the spam folder, or write to
        <a href="mailto:hntoys7@sinuotoys.com" class="text-gold underline underline-offset-4 decoration-gold/40 hover:decoration-gold transition">hntoys7@sinuotoys.com</a>.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {steps.map((s) => (
          <a
            href={s.href}
            target={s.external ? '_blank' : undefined}
            rel={s.external ? 'noopener' : undefined}
            class="group bg-[#0F0F14] border border-white/5 hover:border-gold/30 transition-all duration-500 p-8 flex flex-col"
          >
            <span class="text-[9px] font-bold text-gold uppercase tracking-[0.4em] mb-5">{s.label}</span>
            <span class="text-lg font-display font-extrabold uppercase tracking-tight text-white group-hover:text-gold transition mb-4">{s.title}</span>
            <span class="text-gray-500 text-sm leading-[1.8] mb-8">{s.body}</span>
            <span class="mt-auto text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400 group-hover:text-gold transition">{s.cta} &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
