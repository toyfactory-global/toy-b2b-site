---
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<Layout title={`${product.name} | TOYFACTORY Specifications`}>
	<!-- Navbar -->
	<nav class="bg-dark/95 border-b border-white/5 py-6 sticky top-0 z-50 backdrop-blur-md">
		<div class="max-w-[1600px] mx-auto px-8 flex items-center justify-between">
			<a href="/" class="text-xl font-display font-extrabold tracking-tighter hover:text-gold transition">
				TOY<span class="text-gold">FACTORY</span>
			</a>
			<a href="/" class="text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:text-white transition flex items-center gap-2">
				<span>&larr;</span> BACK TO CATALOG
			</a>
		</div>
	</nav>

	<main class="py-12 md:py-24 px-8 bg-[#050508]">
		<div class="max-w-[1600px] mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-16 xl:gap-24">
				
				<!-- LEFT: IMAGE GALLERY (模仿参考图) -->
				<div class="lg:col-span-7 grid grid-cols-12 gap-4 h-fit">
					<!-- Vertical Thumbnails -->
					<div class="col-span-2 space-y-4">
						{product.images.map((img, idx) => (
							<button 
								class="thumb-btn w-full aspect-square bg-card border border-white/5 p-2 flex items-center justify-center group hover:border-gold/50 transition-all duration-300 overflow-hidden"
								data-index={idx}
							>
								<img src={img} alt={`${product.name} ${idx + 1}`} class="max-w-full max-h-full object-contain opacity-60 group-hover:opacity-100 transition" />
							</button>
						))}
						{/* Placeholder for more images */}
						<div class="w-full aspect-square bg-white/5 border border-dashed border-white/10 flex items-center justify-center">
							<span class="text-[8px] text-gray-700 text-center px-1 uppercase tracking-tighter font-bold italic">More Shots Coming</span>
						</div>
					</div>

					<!-- Main Image Container -->
					<div class="col-span-10 relative bg-white/5 border border-white/5 aspect-square flex items-center justify-center p-12 overflow-hidden group">
						<!-- Navigation Arrows -->
						<button id="prev-btn" class="absolute left-6 top-1/2 -translate-y-1/2 w-12 h-12 bg-white/10 hover:bg-gold backdrop-blur-md flex items-center justify-center rounded-full text-white hover:text-dark transition-all duration-300 opacity-0 group-hover:opacity-100 z-10 border border-white/10">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
						</button>
						
						<button id="next-btn" class="absolute right-6 top-1/2 -translate-y-1/2 w-12 h-12 bg-white/10 hover:bg-gold backdrop-blur-md flex items-center justify-center rounded-full text-white hover:text-dark transition-all duration-300 opacity-0 group-hover:opacity-100 z-10 border border-white/10">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
						</button>

						<img 
							id="active-image"
							src={product.images[0]} 
							alt={product.name} 
							class="w-full h-full object-contain transition-all duration-500 ease-in-out"
						/>
					</div>
				</div>

				<!-- RIGHT: PRODUCT INFO -->
				<div class="lg:col-span-5">
					<div class="sticky top-32">
						<div class="mb-12">
							<div class="flex items-center gap-4 mb-6">
								<span class="text-gold font-bold text-[10px] uppercase tracking-[0.4em]">Industrial Grade Toy</span>
								<div class="h-px bg-white/10 flex-grow"></div>
							</div>
							<h1 class="text-4xl xl:text-5xl font-display font-extrabold uppercase tracking-tight mb-6 leading-[1.1] text-white">
								{product.name}
							</h1>
							<div class="flex items-center gap-3">
								<span class="text-gray-600 font-mono text-xs tracking-widest uppercase">ITEM NO:</span>
								<span class="text-white font-mono text-xs tracking-widest font-bold">{product.id}</span>
							</div>
						</div>

						<!-- Pricing Tier -->
						<div class="bg-card border border-white/5 p-10 mb-12 relative overflow-hidden">
							<div class="absolute right-[-10%] top-[-10%] text-6xl font-display font-black opacity-[0.03] rotate-12 select-none">WHOLESALE</div>
							<h3 class="text-[9px] font-bold text-gray-500 uppercase tracking-[0.3em] mb-8 italic">Tiered Wholesale Pricing</h3>
							<div class="space-y-6">
								<div class="flex justify-between items-center pb-6 border-b border-white/5">
									<span class="text-xs text-gray-400 font-light uppercase tracking-widest">35 – 157 pcs</span>
									<span class="text-2xl font-display font-extrabold text-gold">${product.price}/Piece</span>
								</div>
								<div class="flex justify-between items-center pb-6 border-b border-white/5">
									<span class="text-xs text-gray-400 font-light uppercase tracking-widest">158 – 525 pcs</span>
									<span class="text-[10px] font-bold uppercase tracking-[0.2em] text-white italic">Contact for Discount</span>
								</div>
								<div class="flex justify-between items-center">
									<span class="text-xs text-gray-400 font-light uppercase tracking-widest">526+ pcs</span>
									<span class="text-[10px] font-bold uppercase tracking-[0.2em] text-white italic">Best Price | Inquiry Now</span>
								</div>
							</div>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-16">
							<a href="https://wa.me/861349669150" target="_blank" class="bg-[#25D366] text-white text-center py-6 font-bold uppercase tracking-[0.3em] text-[10px] hover:scale-[1.02] transition shadow-[0_20px_40px_rgba(37,211,102,0.2)] flex items-center justify-center gap-3">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
								WhatsApp
							</a>
							<a href="#rfq" class="bg-gold text-dark text-center py-6 font-bold uppercase tracking-[0.3em] text-[10px] hover:bg-white transition flex items-center justify-center">
								Bulk Proposal
							</a>
						</div>

						<!-- Specifications -->
						<div class="border-t border-white/5 pt-12">
							<h3 class="text-[9px] font-bold uppercase tracking-[0.5em] mb-10 text-gray-500 italic underline decoration-gold underline-offset-8">Production Data</h3>
							<div class="grid grid-cols-2 gap-y-10 gap-x-12">
								<div>
									<div class="text-[8px] text-gray-700 uppercase tracking-[0.2em] mb-2 font-bold">Ref No.</div>
									<div class="text-xs font-bold text-white uppercase tracking-widest italic">{product.id}</div>
								</div>
								<div>
									<div class="text-[8px] text-gray-700 uppercase tracking-[0.2em] mb-2 font-bold">Standard MOQ</div>
									<div class="text-xs font-bold text-white uppercase tracking-widest italic">{product.moq} Units</div>
								</div>
								<div>
									<div class="text-[8px] text-gray-700 uppercase tracking-[0.2em] mb-2 font-bold">QC Standard</div>
									<div class="text-xs font-bold text-white uppercase tracking-widest italic">ISO-9001 / AQL 2.5</div>
								</div>
								<div>
									<div class="text-[8px] text-gray-700 uppercase tracking-[0.2em] mb-2 font-bold">Port of Loading</div>
									<div class="text-xs font-bold text-white uppercase tracking-widest italic">Yantian / Shantou</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- RFQ Section -->
			<section id="rfq" class="mt-40 pt-32 border-t border-white/5">
				<div class="max-w-3xl">
					<span class="text-gold font-bold text-[9px] uppercase tracking-[0.5em] mb-6 block italic underline underline-offset-4 decoration-gold/50">Project Inquiry</span>
					<h2 class="text-4xl md:text-5xl font-display font-extrabold uppercase mb-6 tracking-tighter italic">Inquire About {product.id}</h2>
					<p class="text-gray-500 mb-16 uppercase text-[9px] tracking-[0.3em] font-bold leading-loose">
						Our engineering team will review your requirements and provide a formal manufacturing proposal within 24 hours.
					</p>
					
					<form class="grid grid-cols-1 md:grid-cols-2 gap-10">
						<div class="space-y-4">
							<label class="text-[8px] font-bold text-gray-600 uppercase tracking-widest ml-1">Client Representative</label>
							<input type="text" class="w-full bg-card border border-white/5 p-5 focus:border-gold outline-none text-xs text-white uppercase tracking-widest placeholder:text-gray-800" placeholder="Full Name">
						</div>
						<div class="space-y-4">
							<label class="text-[8px] font-bold text-gray-600 uppercase tracking-widest ml-1">Official Email</label>
							<input type="email" class="w-full bg-card border border-white/5 p-5 focus:border-gold outline-none text-xs text-white uppercase tracking-widest placeholder:text-gray-800" placeholder="Business Address">
						</div>
						<div class="col-span-full space-y-4">
							<label class="text-[8px] font-bold text-gray-600 uppercase tracking-widest ml-1">Project Scope</label>
							<textarea rows="4" class="w-full bg-card border border-white/5 p-5 focus:border-gold outline-none text-xs text-white uppercase tracking-widest leading-relaxed placeholder:text-gray-800" placeholder={`I am interested in Item: ${product.id} (${product.name}). Target quantity, branding requirements, and destination...`}></textarea>
						</div>
						<button class="bg-gold text-dark font-black py-6 uppercase hover:bg-white transition tracking-[0.4em] text-[10px] italic shadow-[0_20px_40px_rgba(201,168,76,0.1)]">
							Send Manufacturing Inquiry
						</button>
					</form>
				</div>
			</section>
		</div>
	</main>

	<!-- Footer -->
	<footer class="py-24 border-t border-white/5 bg-[#050508] text-center">
		<div class="text-[9px] text-gray-700 uppercase tracking-[0.4em] font-bold italic">
			&copy; 2026 TOYFACTORY Manufacturing. Global B2B Standards.
		</div>
	</footer>
</Layout>

<script define:vars={{ images: product.images }}>
	const mainImage = document.getElementById('active-image');
	const thumbBtns = document.querySelectorAll('.thumb-btn');
	const prevBtn = document.getElementById('prev-btn');
	const nextBtn = document.getElementById('next-btn');
	
	let currentIndex = 0;

	const updateGallery = (index) => {
		currentIndex = index;
		const newSrc = images[currentIndex];
		
		if (mainImage) {
			mainImage.style.opacity = '0';
			mainImage.style.transform = 'scale(0.98)';
			
			setTimeout(() => {
				mainImage.src = newSrc;
				mainImage.style.opacity = '1';
				mainImage.style.transform = 'scale(1)';
			}, 300);
		}

		// Update thumbnails opacity
		thumbBtns.forEach((btn, i) => {
			const img = btn.querySelector('img');
			if (i === currentIndex) {
				btn.classList.add('border-gold');
				img.style.opacity = '1';
			} else {
				btn.classList.remove('border-gold');
				img.style.opacity = '0.6';
			}
		});
	};

	thumbBtns.forEach((btn, i) => {
		btn.addEventListener('click', () => updateGallery(i));
	});

	prevBtn?.addEventListener('click', () => {
		const newIndex = (currentIndex - 1 + images.length) % images.length;
		updateGallery(newIndex);
	});

	nextBtn?.addEventListener('click', () => {
		const newIndex = (currentIndex + 1) % images.length;
		updateGallery(newIndex);
	});

	// Initialize
	updateGallery(0);
</script>
