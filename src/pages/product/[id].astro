---
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<Layout title={`${product.name} | TOYFACTORY Specifications`}>
	<!-- Compact Navbar -->
	<nav class="bg-dark/95 border-b border-white/5 py-6">
		<div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
			<a href="/" class="text-lg font-display font-extrabold tracking-tighter hover:text-gold transition">
				TOY<span class="text-gold">FACTORY</span>
			</a>
			<a href="/" class="text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:text-white transition">
				&larr; Back to Catalog
			</a>
		</div>
	</nav>

	<main class="py-16 md:py-32 px-6">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 md:gap-24">
				<!-- Image Section with Gallery Support -->
				<div class="space-y-6">
					<div class="bg-white/5 p-12 flex items-center justify-center aspect-square border border-white/5 overflow-hidden">
						<img 
							id="main-image"
							src={product.images[0]} 
							alt={product.name} 
							class="max-w-full max-h-full object-contain transition-opacity duration-300"
						/>
					</div>
					
					{product.images.length > 1 && (
						<div class="grid grid-cols-4 gap-4">
							{product.images.map((img, idx) => (
								<button 
									class="thumbnail-btn aspect-square bg-white/5 border border-white/10 p-2 flex items-center justify-center hover:border-gold transition overflow-hidden"
									data-src={img}
								>
									<img src={img} alt={`${product.name} ${idx + 1}`} class="max-w-full max-h-full object-contain" />
								</button>
							))}
						</div>
					)}
					
					<div class="text-[10px] text-gray-600 uppercase tracking-widest text-center mt-4">
						Tip: You can add more images by updating the products.json file.
					</div>
				</div>

				<!-- Content Section -->
				<div>
					<div class="mb-12">
						<div class="text-gold font-bold text-xs uppercase tracking-[0.3em] mb-4">Industrial Grade Toy</div>
						<h1 class="text-4xl md:text-5xl font-display font-extrabold uppercase tracking-tight mb-4 leading-tight">
							{product.name}
						</h1>
						<div class="text-gray-500 font-mono text-sm tracking-widest uppercase">ITEM NO: {product.id}</div>
					</div>

					<!-- Pricing Tier -->
					<div class="bg-card border border-white/5 p-8 mb-12">
						<h3 class="text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em] mb-6">Tiered Wholesale Pricing</h3>
						<div class="space-y-4">
							<div class="flex justify-between items-center pb-4 border-b border-white/5">
								<span class="text-sm text-gray-400 font-light">35 – 157 pcs</span>
								<span class="text-xl font-bold font-display text-gold">${product.price}/Piece</span>
							</div>
							<div class="flex justify-between items-center pb-4 border-b border-white/5">
								<span class="text-sm text-gray-400 font-light">158 – 525 pcs</span>
								<span class="text-sm font-bold uppercase tracking-widest text-white">Contact for Discount</span>
							</div>
							<div class="flex justify-between items-center">
								<span class="text-sm text-gray-400 font-light">526+ pcs</span>
								<span class="text-sm font-bold uppercase tracking-widest text-white">Best Price | Inquiry Now</span>
							</div>
						</div>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-16">
						<a href="https://wa.me/861349669150" target="_blank" class="bg-[#25D366] text-white text-center py-5 font-bold uppercase tracking-widest text-[10px] hover:scale-105 transition shadow-lg shadow-green-500/20">
							Chat on WhatsApp
						</a>
						<a href="#rfq" class="bg-gold text-dark text-center py-5 font-bold uppercase tracking-widest text-[10px] hover:bg-white transition">
							Request Bulk Quote
						</a>
					</div>

					<!-- Specifications -->
					<div class="border-t border-white/10 pt-12">
						<h3 class="text-xs font-bold uppercase tracking-[0.4em] mb-8">Product Specifications</h3>
						<div class="grid grid-cols-2 gap-y-8 gap-x-12">
							<div>
								<div class="text-[9px] text-gray-500 uppercase tracking-widest mb-1">Item Number</div>
								<div class="text-sm font-bold text-white uppercase">{product.id}</div>
							</div>
							<div>
								<div class="text-[9px] text-gray-500 uppercase tracking-widest mb-1">Minimum Order</div>
								<div class="text-sm font-bold text-white uppercase">{product.moq} Pieces</div>
							</div>
							<div>
								<div class="text-[9px] text-gray-500 uppercase tracking-widest mb-1">Sample Availability</div>
								<div class="text-sm font-bold text-white uppercase">Available on Request</div>
							</div>
							<div>
								<div class="text-[9px] text-gray-500 uppercase tracking-widest mb-1">Shipping Ports</div>
								<div class="text-sm font-bold text-white uppercase">Shantou / Shenzhen</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- RFQ Form -->
			<section id="rfq" class="mt-32 pt-32 border-t border-white/5">
				<div class="max-w-3xl">
					<h2 class="text-3xl font-display font-extrabold uppercase mb-4">Inquire About {product.id}</h2>
					<p class="text-gray-400 mb-12 uppercase text-[10px] tracking-widest font-bold">Our team will get back to you with a detailed proposal within 24 hours.</p>
					
					<form class="grid grid-cols-1 md:grid-cols-2 gap-8">
						<div class="space-y-2">
							<label class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Your Name</label>
							<input type="text" class="w-full bg-card border border-white/10 p-4 focus:border-gold outline-none text-sm" placeholder="John Doe">
						</div>
						<div class="space-y-2">
							<label class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Business Email</label>
							<input type="email" class="w-full bg-card border border-white/10 p-4 focus:border-gold outline-none text-sm" placeholder="email@company.com">
						</div>
						<div class="col-span-full space-y-2">
							<label class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Inquiry Details</label>
							<textarea rows="4" class="w-full bg-card border border-white/10 p-4 focus:border-gold outline-none text-sm" placeholder={`Hello, I am interested in Item No: ${product.id} (${product.name}). Looking for a quote on...`}></textarea>
						</div>
						<button class="bg-gold text-dark font-extrabold py-5 uppercase hover:bg-white transition tracking-[0.3em] text-[10px]">
							Submit Inquiry
						</button>
					</form>
				</div>
			</section>
		</div>
	</main>

	<!-- Footer -->
	<footer class="py-20 border-t border-white/5 bg-dark text-center">
		<p class="text-[10px] text-gray-600 uppercase tracking-[0.3em]">&copy; 2026 TOYFACTORY Manufacturing. Global B2B Excellence.</p>
	</footer>
</Layout>

<script>
	const mainImage = document.getElementById('main-image');
	const thumbBtns = document.querySelectorAll('.thumbnail-btn');

	thumbBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			const newSrc = btn.getAttribute('data-src');
			if (mainImage && newSrc) {
				mainImage.style.opacity = '0';
				setTimeout(() => {
					mainImage.src = newSrc;
					mainImage.style.opacity = '1';
				}, 300);
			}
		});
	});
</script>
