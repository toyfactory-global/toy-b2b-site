---
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<Layout title={`${product.name} | SKU: ${product.id} | Toy Factory`}>
	<!-- Header Placeholder (can reuse from index or make a component later) -->
	<header class="bg-dark border-b border-white/10">
		<div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
			<a href="/" class="text-2xl font-display font-bold tracking-tighter">
				TOY<span class="text-gold">FACTORY</span>
			</a>
			<a href="/" class="text-xs uppercase tracking-widest hover:text-gold transition">Back to Catalog</a>
		</div>
	</header>

	<main class="py-12 md:py-24 px-6">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-16">
				<!-- Image Section -->
				<div class="bg-card border border-white/5 p-4 md:p-12 flex items-center justify-center aspect-square">
					<img 
						src={product.image} 
						alt={product.name} 
						class="w-full h-full object-contain"
						onerror="this.src='https://placehold.co/800x800/1a1a1a/c9a84c?text=Product+Image'"
					/>
				</div>

				<!-- Details Section -->
				<div>
					<div class="text-gold font-bold uppercase tracking-widest text-xs mb-4">Item No: {product.id}</div>
					<h1 class="text-3xl md:text-5xl font-display font-bold mb-6 leading-tight uppercase">{product.name}</h1>
					<p class="text-gray-400 mb-8 pb-8 border-b border-white/5 italic">
						{product.cn_name}
					</p>

					<!-- Tiered Pricing (Custom Style from Image) -->
					<div class="bg-dark p-8 border-l-4 border-gold mb-10">
						<h3 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-6">Tiered Wholesale Pricing</h3>
						<ul class="space-y-4">
							<li class="flex items-center gap-3">
								<span class="w-2 h-2 rounded-full border border-gold"></span>
								<span class="text-sm">
									<span class="text-gray-400 font-mono">{product.moq} – {Math.floor(product.moq * 4.5)}pcs:</span> 
									<span class="text-white font-bold ml-2">${product.price}/Piece</span>
								</span>
							</li>
							<li class="flex items-center gap-3">
								<span class="w-2 h-2 rounded-full border border-gray-600"></span>
								<span class="text-sm">
									<span class="text-gray-400 font-mono">{Math.floor(product.moq * 4.5) + 1} – {Math.floor(product.moq * 15)}pcs:</span> 
									<span class="text-white font-bold ml-2">Contact for discount</span>
								</span>
							</li>
							<li class="flex items-center gap-3">
								<span class="w-2 h-2 rounded-full border border-gray-600"></span>
								<span class="text-sm">
									<span class="text-gray-400 font-mono">{Math.floor(product.moq * 15) + 1}+pcs:</span> 
									<span class="text-gold font-bold ml-2 uppercase tracking-tighter">Best Price | Inquiry Now</span>
								</span>
							</li>
						</ul>
						<div class="mt-8 text-[11px] text-gray-500 border-t border-white/5 pt-4">
							<span class="text-gold mr-1">•</span> Bulk order discount available, contact us for exact quote.
						</div>
					</div>

					<div class="flex flex-col gap-4">
						<a href="#rfq" class="w-full bg-gold text-dark text-center py-5 font-bold uppercase tracking-widest hover:bg-white transition">
							Request Bulk Quote
						</a>
						<a href="https://wa.me/8612345678910" target="_blank" class="w-full border border-green-500 text-green-500 text-center py-5 font-bold uppercase tracking-widest hover:bg-green-500 hover:text-white transition flex items-center justify-center gap-2">
							Chat on WhatsApp
						</a>
					</div>
				</div>
			</div>

			<!-- Additional Info -->
			<div class="mt-24 pt-24 border-t border-white/5">
				<h2 class="text-2xl font-display font-bold mb-12 uppercase tracking-widest">Product Specifications</h2>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
					<div class="border-l border-white/10 pl-6">
						<div class="text-xs uppercase text-gray-500 mb-2">Item Number</div>
						<div class="text-lg font-bold">{product.id}</div>
					</div>
					<div class="border-l border-white/10 pl-6">
						<div class="text-xs uppercase text-gray-500 mb-2">Minimum Order</div>
						<div class="text-lg font-bold">{product.moq} Pieces</div>
					</div>
					<div class="border-l border-white/10 pl-6">
						<div class="text-xs uppercase text-gray-500 mb-2">Sample Availability</div>
						<div class="text-lg font-bold text-gold">Available on Request</div>
					</div>
				</div>
			</div>
		</div>

		<!-- RFQ Form (Simplified Copy from Index) -->
		<section id="rfq" class="mt-32 max-w-4xl mx-auto bg-card border border-white/5 p-12">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-display font-bold mb-4 uppercase">INQUIRE ABOUT {product.id}</h2>
				<p class="text-gray-400">Our team will get back to you with a detailed proposal within 24 hours.</p>
			</div>
			<form class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<input type="text" placeholder="Your Name" class="bg-dark border border-white/10 p-4 focus:border-gold outline-none">
				<input type="email" placeholder="Business Email" class="bg-dark border border-white/10 p-4 focus:border-gold outline-none">
				<textarea placeholder="Message (Quantity, Delivery Location, Customization...)" rows="4" class="bg-dark border border-white/10 p-4 focus:border-gold outline-none col-span-full">Hello, I am interested in Item No: {product.id} ({product.name}). I would like to request a quote for ... units.</textarea>
				<button class="bg-gold text-dark font-bold py-5 uppercase hover:bg-white transition col-span-full tracking-widest">
					Submit Inquiry
				</button>
			</form>
		</section>
	</main>

	<footer class="py-12 border-t border-white/10 text-center text-gray-600 text-sm">
		<p>&copy; 2026 TOYFACTORY Manufacturing. All rights reserved.</p>
	</footer>
</Layout>
