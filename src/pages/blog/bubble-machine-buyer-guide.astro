---
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';
import { blogPosting, blogBreadcrumb } from '../../lib/schema';

const post = blogPosting({
  slug: 'bubble-machine-buyer-guide',
  title: 'Bubble Machine Wholesale Guide: Ten Models Compared on Cartons',
  description:
    'Wholesale bubble machines compared on cartons per container, cash to enter and value density. Ten models from $1.58, MOQ 72 to 720, with the questions that actually separate them.',
  date: '2026-11-21',
  category: 'Product Guide',
  image: '/images/products/TF200892.webp',
});

const firstNumber = (v: any) => {
  const m = String(v ?? '').match(/\d+(\.\d+)?/);
  return m ? parseFloat(m[0]) : null;
};

const rows = products
  .filter((p: any) => p.category === 'Bubble Toys')
  .map((p: any) => {
    const qpc = firstNumber(p.specs?.qty_per_carton) || 0;
    const cbm = firstNumber(p.specs?.cbm) || 0;
    return {
      id: p.id,
      moq: p.moq,
      price: p.price,
      qpc,
      cbm,
      cartons: qpc ? Math.ceil(p.moq / qpc) : 0,
      cash: Math.round(p.moq * p.price),
      ctn20: cbm ? Math.floor(28 / cbm + 1e-9) : 0,
      density: cbm && qpc ? Math.round((p.price * qpc) / cbm) : 0,
    };
  })
  .sort((a: any, b: any) => a.price - b.price);

const cheapest = rows[0];
const priciest = rows[rows.length - 1];
const lowestCash = [...rows].sort((a, b) => a.cash - b.cash)[0];
const highestCash = [...rows].sort((a, b) => b.cash - a.cash)[0];
const densest = [...rows].sort((a, b) => b.density - a.density)[0];

const faqs = [
  {
    q: 'What is a typical MOQ for wholesale bubble machines?',
    a: `In this collection it runs from ${Math.min(...rows.map((r) => r.moq))} to ${Math.max(...rows.map((r) => r.moq))} pieces, and the minimum is set by the carton rather than by negotiation. Express it in cartons before comparing suppliers: the low-piece minimums here are ${Math.min(...rows.map((r) => r.cartons))} cartons, while the high ones reach ${Math.max(...rows.map((r) => r.cartons))}.`,
  },
  {
    q: 'Why is the cheapest bubble machine per piece not the best first order?',
    a: `The lowest unit price is the ${cheapest.id} at $${cheapest.price}, but its minimum is ${cheapest.moq} pieces, so entering costs about $${cheapest.cash.toLocaleString('en-US')}. The ${lowestCash.id} costs more per piece at $${lowestCash.price} and less in total at about $${lowestCash.cash.toLocaleString('en-US')}. On a first order, cash matters more than unit price.`,
  },
  {
    q: 'How many bubble machines fit in a container?',
    a: `Cartons per 20GP range from ${Math.min(...rows.map((r) => r.ctn20))} to ${Math.max(...rows.map((r) => r.ctn20))} across the ten models, depending on carton volume. Multiply by pieces per carton for the piece count, and remember the container figure uses 28 CBM of usable space — your forwarder may use a different number.`,
  },
  {
    q: 'Battery or plug-in: which sells better?',
    a: 'That depends on who you sell to, and it is a question about your market rather than about the factory. Battery units travel to events; plug-in units stay where there is power. What the product record tells you is the packaging format, the carton size and the pieces per carton — the electrical specification should be confirmed per item number before you commit, in writing.',
  },
  {
    q: 'Do you supply test reports for bubble machines?',
    a: 'Testing scope varies by model and by destination market, so it is answered per item number rather than as a catalogue-wide claim. Tell us the model and the country and the reply states which reports exist for that combination. We do not imply a certificate for a market that is not named in the quotation.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  title="Bubble Machine Wholesale Guide: Ten Models Compared"
  description={post.description}
  keywords="wholesale bubble machine, bubble gun wholesale, bubble toy factory, bulk bubble machines, bubble machine MOQ"
  jsonLd={[post, blogBreadcrumb(post.title, 'bubble-machine-buyer-guide'), faqSchema]}
>
  <nav class="bg-dark/95 border-b border-white/5 py-6 sticky top-0 z-50 backdrop-blur-md">
    <div class="max-w-[1600px] mx-auto px-8 flex items-center justify-between">
      <a href="/" class="text-xl font-display font-extrabold tracking-tighter hover:text-gold transition">
        TOY<span class="text-gold">FACTORY</span>
      </a>
      <a href="/blog" class="text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:text-white transition flex items-center gap-2">
        <span>&larr;</span> BACK TO BLOG
      </a>
    </div>
  </nav>

  <article class="py-24 md:py-32 px-8 bg-[#0A0A0F] min-h-screen">
    <div class="max-w-[1100px] mx-auto">
      <div class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <span class="bg-gold/10 text-gold text-[8px] font-bold px-2 py-0.5 uppercase tracking-widest border border-gold/20">Product Guide</span>
          <span class="text-gray-600 text-[10px] uppercase tracking-widest">2026-11-21 · 6 min read</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-display font-extrabold text-white leading-[1.05] mb-8 tracking-tight">
          Bubble machine wholesale: ten models compared on cartons
        </h1>
        <p class="text-gray-400 text-lg leading-[1.8] max-w-3xl">
          Bubble machines look like a commodity and are not. The ten models in this collection span a four-fold range in
          unit price and a two-fold range in carton volume — and the carton is what decides whether a container makes
          money.
        </p>
      </div>

      <div class="aspect-[21/9] overflow-hidden bg-white/5 mb-16 border border-white/5">
        <img src="/images/products/TF200892-3.webp" alt="Wholesale bubble machine from a Chenghai toy factory" class="w-full h-full object-cover" />
      </div>

      <div class="space-y-10 text-gray-400 leading-[1.9]">
        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">Five questions, only two of which the catalogue can answer</h2>
          <p>
            Wholesale buyers arrive with five questions: how many bubbles a minute, battery or plug-in, how long it
            lasts, what the minimum is, and what it costs to ship. The catalogue answers the last two precisely and the
            other three only by item number — which is why the honest version of this guide is about cartons and cash,
            and the technical questions are listed at the end for you to ask.
          </p>
          <p>
            What follows is calculated from the same product records used to quote. Nothing here is a marketing figure.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">The ten models, sorted by unit price</h2>
          <div class="overflow-x-auto border border-white/10 my-8">
            <table class="w-full text-sm min-w-[800px]">
              <thead>
                <tr class="border-b border-white/10 text-[9px] uppercase tracking-[0.2em] text-gray-500">
                  <th class="text-left px-4 py-4 font-bold">Model</th>
                  <th class="text-right px-4 py-4 font-bold">MOQ</th>
                  <th class="text-right px-4 py-4 font-bold">Cartons</th>
                  <th class="text-right px-4 py-4 font-bold">USD/pc</th>
                  <th class="text-right px-4 py-4 font-bold">Pcs/ctn</th>
                  <th class="text-right px-4 py-4 font-bold">CBM</th>
                  <th class="text-right px-4 py-4 font-bold">20GP ctns</th>
                  <th class="text-right px-4 py-4 font-bold">$ per CBM</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr class="border-b border-white/5 last:border-0">
                    <td class="px-4 py-4"><a href={`/product/${r.id}`} class="text-white hover:text-gold transition font-bold">{r.id}</a></td>
                    <td class="px-4 py-4 text-right text-gray-300">{r.moq}</td>
                    <td class="px-4 py-4 text-right text-gold">{r.cartons}</td>
                    <td class="px-4 py-4 text-right text-gray-300">${r.price}</td>
                    <td class="px-4 py-4 text-right text-gray-400">{r.qpc}</td>
                    <td class="px-4 py-4 text-right text-gray-400">{r.cbm}</td>
                    <td class="px-4 py-4 text-right text-gray-400">{r.ctn20}</td>
                    <td class="px-4 py-4 text-right text-white">{r.density}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-gray-500 text-sm">
            &ldquo;Cartons&rdquo; is the minimum expressed in cartons. &ldquo;$ per CBM&rdquo; is the value of one
            carton divided by its volume — a rough measure of how much money a container can carry.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">The cheap-per-piece trap</h2>
          <p>
            The lowest unit price here is the {cheapest.id} at ${cheapest.price}; the highest is the {priciest.id} at $
            {priciest.price}. If you sorted by price and bought the top of the list, you would be committing about $
            {cheapest.cash.toLocaleString('en-US')} to enter — against ${lowestCash.cash.toLocaleString('en-US')} for the{' '}
            {lowestCash.id}, which costs ${lowestCash.price} per piece.
          </p>
          <p>
            That gap is not a trick. A high-volume model is priced for volume: the carton holds more, the minimum is
            higher, and the unit price assumes you take the volume. The trap is buying it for a market test.
          </p>
          <p>
            At the other end, the {highestCash.id} needs about ${highestCash.cash.toLocaleString('en-US')} to enter. It is
            a perfectly reasonable model for a distributor who knows the demand; it is a poor first order for someone who
            does not.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">Value density: the number that pays the freight</h2>
          <p>
            Bubble machines are bulky and light, so freight is usually decided by volume rather than weight. Divide the
            value of a carton by its volume and you get how much money a cubic metre of container space can carry: the{' '}
            {densest.id} carries about ${densest.density} per CBM, and lower-density models carry proportionally less.
          </p>
          <p>
            This matters when two models show a similar unit price. If one needs twice the container space per dollar of
            goods, its real cost is higher as soon as the container leaves the port. That is also why the carton columns
            are published on every product page instead of hidden behind a "contact us".
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">The three questions to ask by item number</h2>
          <p>
            <span class="text-white">Output.</span> Ask for a rated figure at maximum output, and ask whether it was
            measured or estimated. "High output" is not a specification.
          </p>
          <p>
            <span class="text-white">Power.</span> Battery or mains changes the market you can sell into, and it changes
            what the carton has to protect. Confirm it per model rather than assuming from a photograph.
          </p>
          <p>
            <span class="text-white">Testing.</span> Reports are issued per model and per destination market. Ask for the
            combination you actually need — a report for another market is not a shortcut through customs.
          </p>
        </section>
      </div>

      <div class="mt-16 border-t border-white/10 pt-12">
        <h2 class="text-2xl font-display font-bold text-white mb-8 tracking-tight">Bubble machine questions</h2>
        <div class="space-y-8">
          {faqs.map((f) => (
            <div>
              <h3 class="text-white text-lg font-bold mb-3 tracking-tight">{f.q}</h3>
              <p class="text-gray-400 leading-[1.9]">{f.a}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="bg-[#0F0F14] border border-white/5 p-8 mt-16">
        <span class="text-gold font-bold text-[9px] uppercase tracking-[0.4em] block mb-4">Next step</span>
        <p class="text-gray-300 leading-[1.9] mb-6">
          Pick the model that fits your cash rather than the one with the lowest price, then send the item number with the
          quantity and the destination market.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/category/bubble-toys" class="bg-gold text-dark font-black px-8 py-4 uppercase tracking-[0.3em] text-[10px] hover:bg-white transition">Bubble toys collection</a>
          <a href="/industries/party-supplies-distributors" class="border border-white/15 text-white font-black px-8 py-4 uppercase tracking-[0.3em] text-[10px] hover:border-gold hover:text-gold transition">For party distributors</a>
          <a href="/blog/toy-moq-cartons-guide" class="border border-white/15 text-white font-black px-8 py-4 uppercase tracking-[0.3em] text-[10px] hover:border-gold hover:text-gold transition">MOQ explained</a>
        </div>
      </div>
    </div>
  </article>
</Layout>
