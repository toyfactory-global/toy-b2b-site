---
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';
import { blogPosting, blogBreadcrumb } from '../../lib/schema';

const post = blogPosting({
  slug: 'water-gun-wholesale-guide',
  title: 'Water Gun Wholesale: Building a Summer Range Without Dead Stock',
  description:
    'Fifteen water guns, three of them priced identically at $3.42 but with very different cartons. How to build a summer range around price bands, cartons and cash rather than around unit price.',
  date: '2026-11-21',
  category: 'Product Guide',
  image: '/images/products/TF210969.webp',
});

const firstNumber = (v: any) => {
  const m = String(v ?? '').match(/\d+(\.\d+)?/);
  return m ? parseFloat(m[0]) : null;
};

const rows = products
  .filter((p: any) => p.category === 'Water Guns')
  .map((p: any) => {
    const qpc = firstNumber(p.specs?.qty_per_carton) || 0;
    const cbm = firstNumber(p.specs?.cbm) || 0;
    return {
      id: p.id,
      moq: p.moq,
      price: p.price,
      qpc,
      cbm,
      cartons: qpc ? Math.ceil(p.moq / qpc) : 0,
      cash: Math.round(p.moq * p.price),
      cbmPerPiece: qpc && cbm ? Math.round((cbm / qpc) * 10000) / 10000 : 0,
    };
  })
  .sort((a: any, b: any) => a.price - b.price);

const bands = [
  { label: 'Under $4.00', test: (p: number) => p < 4 },
  { label: '$4.00 – $5.99', test: (p: number) => p >= 4 && p < 6 },
  { label: '$6.00 – $9.99', test: (p: number) => p >= 6 && p < 10 },
  { label: '$10.00 and up', test: (p: number) => p >= 10 },
].map((b) => ({ label: b.label, items: rows.filter((r: any) => b.test(r.price)) }));

/* The three models that share a unit price but not a carton. */
const samePrice = rows.filter((r: any) => r.price === 3.42);
const cheapestUnit = rows[0];
const lowestCash = [...rows].sort((a, b) => a.cash - b.cash)[0];
const highestCash = [...rows].sort((a, b) => b.cash - a.cash)[0];

const faqs = [
  {
    q: 'Why do three water guns cost the same per piece but ship differently?',
    a: `Because the price reflects the product and the carton reflects the packaging. ${samePrice.map((r: any) => r.id).join(', ')} all sit at $3.42, but their cartons hold ${samePrice.map((r: any) => r.qpc).join(', ')} pieces in ${samePrice.map((r: any) => r.cbm).join(', ')} CBM respectively — so the space cost per piece is not the same, and on a container it is the space that decides your margin.`,
  },
  {
    q: 'What is the MOQ on water guns?',
    a: `Between ${Math.min(...rows.map((r) => r.moq))} and ${Math.max(...rows.map((r) => r.moq))} pieces depending on the model, set by the carton. In cartons that is ${Math.min(...rows.map((r) => r.cartons))} to ${Math.max(...rows.map((r) => r.cartons))}, which is the figure to use when planning storage or a container.`,
  },
  {
    q: 'How many models should a first summer order include?',
    a: 'Fewer than most buyers expect. Three to five models across two or three price bands is enough to read the market; ordering all fifteen at minimum ties up cash in models you have not tested. The carton quantity tells you the true commitment for each line.',
  },
  {
    q: 'Can I mix water guns with other categories in one container?',
    a: 'Yes. All four collections load from Shantou or Shenzhen, and mixing is normal on a first order. Add the CBM of every carton and compare the total against the container volume — the calculator on this site does that arithmetic for a mixed list.',
  },
  {
    q: 'When should a summer water gun order be placed?',
    a: 'Work backwards from the date you need stock on shelf. Production averages twenty days from order confirmation, and the sea leg is usually longer than that. Placing an order in April for a June shelf date leaves no room for a delay at the port.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  title="Water Gun Wholesale: Building a Summer Range Without Dead Stock"
  description={post.description}
  keywords="water gun wholesale, bulk water guns, summer toy range, wholesale squirt guns, water gun factory china"
  jsonLd={[post, blogBreadcrumb(post.title, 'water-gun-wholesale-guide'), faqSchema]}
>
  <nav class="bg-dark/95 border-b border-white/5 py-6 sticky top-0 z-50 backdrop-blur-md">
    <div class="max-w-[1600px] mx-auto px-8 flex items-center justify-between">
      <a href="/" class="text-xl font-display font-extrabold tracking-tighter hover:text-gold transition">
        TOY<span class="text-gold">FACTORY</span>
      </a>
      <a href="/blog" class="text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:text-white transition flex items-center gap-2">
        <span>&larr;</span> BACK TO BLOG
      </a>
    </div>
  </nav>

  <article class="py-24 md:py-32 px-8 bg-[#0A0A0F] min-h-screen">
    <div class="max-w-[1100px] mx-auto">
      <div class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <span class="bg-gold/10 text-gold text-[8px] font-bold px-2 py-0.5 uppercase tracking-widest border border-gold/20">Product Guide</span>
          <span class="text-gray-600 text-[10px] uppercase tracking-widest">2026-11-21 · 5 min read</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-display font-extrabold text-white leading-[1.05] mb-8 tracking-tight">
          Water gun wholesale: building a summer range without dead stock
        </h1>
        <p class="text-gray-400 text-lg leading-[1.8] max-w-3xl">
          Summer ranges fail in one of two ways: too narrow to fill a shelf, or so wide that half of it is still in the
          warehouse in September. The fifteen models here split cleanly into four price bands — and inside one of those
          bands, three items at the same price behave very differently on a container.
        </p>
      </div>

      <div class="space-y-10 text-gray-400 leading-[1.9]">
        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">Build by band, not by model</h2>
          <p>
            A shelf reads as price steps, not as a catalogue. Most water gun ranges need three: an entry item bought on
            impulse, a middle item bought as a gift, and one larger item that anchors the display. The fifteen models
            divide into four bands:
          </p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-white/5 border border-white/10 my-8">
            {bands.map((b) => (
              <div class="bg-[#0A0A0F] px-5 py-6">
                <div class="text-2xl font-display font-extrabold text-gold">{b.items.length}</div>
                <div class="text-[9px] uppercase tracking-[0.2em] text-gray-500 mt-2">{b.label}</div>
                <div class="text-[10px] text-gray-600 mt-3 leading-relaxed">{b.items.map((r: any) => r.id).join(' · ')}</div>
              </div>
            ))}
          </div>
          <p>
            Two models per band is usually enough to read a market. That is six lines, not fifteen, and the cartons stay
            manageable.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">Same price, different carton</h2>
          <p>
            {samePrice.map((r: any) => r.id).join(', ')} all sit at ${samePrice[0].price} per piece. On a price list they
            are interchangeable. On a container they are not:
          </p>
          <div class="overflow-x-auto border border-white/10 my-8">
            <table class="w-full text-sm min-w-[680px]">
              <thead>
                <tr class="border-b border-white/10 text-[9px] uppercase tracking-[0.2em] text-gray-500">
                  <th class="text-left px-5 py-4 font-bold">Model</th>
                  <th class="text-right px-5 py-4 font-bold">USD/pc</th>
                  <th class="text-right px-5 py-4 font-bold">Pcs/ctn</th>
                  <th class="text-right px-5 py-4 font-bold">CBM/ctn</th>
                  <th class="text-right px-5 py-4 font-bold">CBM per piece</th>
                  <th class="text-right px-5 py-4 font-bold">MOQ</th>
                </tr>
              </thead>
              <tbody>
                {samePrice.map((r: any) => (
                  <tr class="border-b border-white/5 last:border-0">
                    <td class="px-5 py-4"><a href={`/product/${r.id}`} class="text-white hover:text-gold transition font-bold">{r.id}</a></td>
                    <td class="px-5 py-4 text-right text-gray-300">${r.price}</td>
                    <td class="px-5 py-4 text-right text-gray-400">{r.qpc}</td>
                    <td class="px-5 py-4 text-right text-gray-400">{r.cbm}</td>
                    <td class="px-5 py-4 text-right text-white">{r.cbmPerPiece}</td>
                    <td class="px-5 py-4 text-right text-gray-400">{r.moq}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p>
            The difference in CBM per piece is the difference in freight per piece. Three products with the same price tag
            do not cost the same to land, and the one that looks identical on a purchase order is the one that quietly
            compresses your margin.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">Cash to enter the range</h2>
          <p>
            The lowest unit price here is ${cheapestUnit.price} on the {cheapestUnit.id}; the smallest total commitment is
            the {lowestCash.id} at about ${lowestCash.cash.toLocaleString('en-US')} for {lowestCash.moq} pieces. The
            largest is the {highestCash.id} at roughly ${highestCash.cash.toLocaleString('en-US')}.
          </p>
          <p>
            Because water guns sit at the low end of the price range, buyers assume the whole category is cheap to start.
            It is cheap per piece; a six-line range at minimum is the number that matters, and it is several times the
            cost of one model.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">The retail box decides whether it fits the shelf</h2>
          <p>
            Each product page publishes the retail packaging size next to the carton size, and the two are not the same
            decision. The retail box decides whether the item sits on a shelf, hangs on a peg or ends up in a basket by
            the till; the carton decides what you pay for freight. A range can be perfectly priced and still fail because
            the boxes do not fit the planogram.
          </p>
          <p>
            If your fixtures are fixed, send the dimensions before choosing models. It is a two-minute question at the
            start and an expensive one after the container arrives.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">Timing, and why April is already late</h2>
          <p>
            Production averages twenty days from order confirmation. The sea leg from Shantou or Shenzhen is usually the
            longer half of the journey, and a port delay is not something a factory can absorb for you. Orders placed for
            a June shelf date in April leave no buffer at all.
          </p>
          <p>
            The useful habit is to work backwards from the shelf date: subtract the sea leg, subtract customs, subtract
            twenty days of production, and the date you are left with is the one to order by. For most northern-hemisphere
            buyers that lands in the first quarter, not the second.
          </p>
        </section>
      </div>

      <div class="mt-16 border-t border-white/10 pt-12">
        <h2 class="text-2xl font-display font-bold text-white mb-8 tracking-tight">Water gun questions</h2>
        <div class="space-y-8">
          {faqs.map((f) => (
            <div>
              <h3 class="text-white text-lg font-bold mb-3 tracking-tight">{f.q}</h3>
              <p class="text-gray-400 leading-[1.9]">{f.a}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="bg-[#0F0F14] border border-white/5 p-8 mt-16">
        <span class="text-gold font-bold text-[9px] uppercase tracking-[0.4em] block mb-4">Next step</span>
        <p class="text-gray-300 leading-[1.9] mb-6">
          The full model-by-model table for all fifteen water guns — price, MOQ, cartons, CBM and pieces per container —
          is on the comparison page.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/blog/water-gun-models-compared" class="bg-gold text-dark font-black px-8 py-4 uppercase tracking-[0.3em] text-[10px] hover:bg-white transition">All 15 models compared</a>
          <a href="/category/water-guns" class="border border-white/15 text-white font-black px-8 py-4 uppercase tracking-[0.3em] text-[10px] hover:border-gold hover:text-gold transition">Water gun collection</a>
          <a href="/container-calculator" class="border border-white/15 text-white font-black px-8 py-4 uppercase tracking-[0.3em] text-[10px] hover:border-gold hover:text-gold transition">Container calculator</a>
        </div>
      </div>
    </div>
  </article>
</Layout>
