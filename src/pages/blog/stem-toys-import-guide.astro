---
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';
import { blogPosting, blogBreadcrumb } from '../../lib/schema';

const post = blogPosting({
  slug: 'stem-toys-import-guide',
  title: 'Educational Toys Wholesale: Seven Models and the Freight Maths',
  description:
    'Buying educational toys for schools, catalogues and retail: the seven models compared on cash to enter, cartons and value density, plus what to confirm per item before you order.',
  date: '2026-11-21',
  category: 'Product Guide',
  image: '/images/products/TF208799.webp',
});

const firstNumber = (v: any) => {
  const m = String(v ?? '').match(/\d+(\.\d+)?/);
  return m ? parseFloat(m[0]) : null;
};

const rows = products
  .filter((p: any) => p.category === 'Educational Toys')
  .map((p: any) => {
    const qpc = firstNumber(p.specs?.qty_per_carton) || 0;
    const cbm = firstNumber(p.specs?.cbm) || 0;
    return {
      id: p.id,
      moq: p.moq,
      price: p.price,
      qpc,
      cbm,
      cartons: qpc ? Math.ceil(p.moq / qpc) : 0,
      cash: Math.round(p.moq * p.price),
      ctn20: cbm ? Math.floor(28 / cbm + 1e-9) : 0,
      density: cbm && qpc ? Math.round((p.price * qpc) / cbm) : 0,
    };
  })
  .sort((a: any, b: any) => b.density - a.density);

const densest = rows[0];
const thinnest = rows[rows.length - 1];
const lowestCash = [...rows].sort((a, b) => a.cash - b.cash)[0];
const highestCash = [...rows].sort((a, b) => b.cash - a.cash)[0];
const margin = Math.round(densest.density / thinnest.density);

const faqs = [
  {
    q: 'What MOQ applies to educational toys?',
    a: `It runs from ${Math.min(...rows.map((r) => r.moq))} to ${Math.max(...rows.map((r) => r.moq))} pieces across these seven models, and the figure is set by the carton. Expressed in cartons the minimums are ${Math.min(...rows.map((r) => r.cartons))} to ${Math.max(...rows.map((r) => r.cartons))}, which is the number a school or a catalogue buyer should compare.`,
  },
  {
    q: 'Which educational model is cheapest to ship?',
    a: `By value per cubic metre it is the ${densest.id} at about $${densest.density} of goods per CBM. The ${thinnest.id} carries about $${thinnest.density}, roughly ${margin} times less per unit of container space. If freight is a large share of your landed cost, that difference matters more than a dollar of unit price.`,
  },
  {
    q: 'Are these toys graded by age?',
    a: 'Where the supplier artwork prints an age, it is published on the product page. Where it is not printed, the page says nothing rather than inventing a figure. For a school purchase order, ask for the exact item number and the destination country, and the age marking is confirmed in writing.',
  },
  {
    q: 'Do educational buyers need different certification?',
    a: 'The requirement depends on the destination market and on who is buying — a school in one country and a retailer in another can face different obligations for the same toy. Testing is issued per model and per market, so the only useful question is the item number plus the country.',
  },
  {
    q: 'Can a school order a small quantity?',
    a: `The practical floor is the carton. The lowest cash commitment here is the ${lowestCash.id} at about $${lowestCash.cash.toLocaleString('en-US')} for ${lowestCash.moq} pieces, and the highest is the ${highestCash.id} at about $${highestCash.cash.toLocaleString('en-US')}. A single-classroom order usually does not reach a carton, which is why small buyers normally go through a local distributor.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  title="Educational Toys Wholesale: Seven Models and the Freight Maths"
  description={post.description}
  keywords="educational toys wholesale, school toys supplier, STEM toys import, classroom toys bulk, educational toy factory"
  jsonLd={[post, blogBreadcrumb(post.title, 'stem-toys-import-guide'), faqSchema]}
>
  <nav class="bg-dark/95 border-b border-white/5 py-6 sticky top-0 z-50 backdrop-blur-md">
    <div class="max-w-[1600px] mx-auto px-8 flex items-center justify-between">
      <a href="/" class="text-xl font-display font-extrabold tracking-tighter hover:text-gold transition">
        TOY<span class="text-gold">FACTORY</span>
      </a>
      <a href="/blog" class="text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:text-white transition flex items-center gap-2">
        <span>&larr;</span> BACK TO BLOG
      </a>
    </div>
  </nav>

  <article class="py-24 md:py-32 px-8 bg-[#0A0A0F] min-h-screen">
    <div class="max-w-[1100px] mx-auto">
      <div class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <span class="bg-gold/10 text-gold text-[8px] font-bold px-2 py-0.5 uppercase tracking-widest border border-gold/20">Product Guide</span>
          <span class="text-gray-600 text-[10px] uppercase tracking-widest">2026-11-21 · 6 min read</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-display font-extrabold text-white leading-[1.05] mb-8 tracking-tight">
          Educational toys wholesale: seven models and the freight maths
        </h1>
        <p class="text-gray-400 text-lg leading-[1.8] max-w-3xl">
          Educational buyers talk about curriculum and durability. The freight invoice talks about cubic metres. These
          seven models are compared on the second thing, because it is the one that quietly decides your margin.
        </p>
      </div>

      <div class="space-y-10 text-gray-400 leading-[1.9]">
        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">Two buyers, one catalogue, different questions</h2>
          <p>
            A school district buys against a term date and a budget line. A catalogue distributor buys against a reorder
            cycle. Both need the same three things: a minimum they can afford, a carton that fits their storage, and a
            delivery date that does not move.
          </p>
          <p>
            What separates the seven models below is not how educational they are. It is how much container space each
            one consumes per dollar of goods — a difference of roughly {margin} times between the best and the worst.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">Seven models, ranked by value density</h2>
          <div class="overflow-x-auto border border-white/10 my-8">
            <table class="w-full text-sm min-w-[800px]">
              <thead>
                <tr class="border-b border-white/10 text-[9px] uppercase tracking-[0.2em] text-gray-500">
                  <th class="text-left px-4 py-4 font-bold">Model</th>
                  <th class="text-right px-4 py-4 font-bold">MOQ</th>
                  <th class="text-right px-4 py-4 font-bold">Cartons</th>
                  <th class="text-right px-4 py-4 font-bold">USD/pc</th>
                  <th class="text-right px-4 py-4 font-bold">Pcs/ctn</th>
                  <th class="text-right px-4 py-4 font-bold">CBM</th>
                  <th class="text-right px-4 py-4 font-bold">20GP ctns</th>
                  <th class="text-right px-4 py-4 font-bold">$ per CBM</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr class="border-b border-white/5 last:border-0">
                    <td class="px-4 py-4"><a href={`/product/${r.id}`} class="text-white hover:text-gold transition font-bold">{r.id}</a></td>
                    <td class="px-4 py-4 text-right text-gray-300">{r.moq}</td>
                    <td class="px-4 py-4 text-right text-gold">{r.cartons}</td>
                    <td class="px-4 py-4 text-right text-gray-300">${r.price}</td>
                    <td class="px-4 py-4 text-right text-gray-400">{r.qpc}</td>
                    <td class="px-4 py-4 text-right text-gray-400">{r.cbm}</td>
                    <td class="px-4 py-4 text-right text-gray-400">{r.ctn20}</td>
                    <td class="px-4 py-4 text-right text-white">{r.density}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-gray-500 text-sm">
            Sorted by $ per CBM, highest first. Cartons per 20GP uses 28 CBM of usable space — an assumption, not a
            measurement of your loading plan.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">The small carton is the quiet hero</h2>
          <p>
            The {densest.id} carries about ${densest.density} of goods per cubic metre, on a carton of just{' '}
            {densest.cbm} CBM. The {thinnest.id} carries ${thinnest.density} on {thinnest.cbm} CBM. Put a container of
            each on the water and the first one is carrying roughly {margin} times the value for the same freight.
          </p>
          <p>
            This is not an argument for buying only dense products — a range needs variety, and a customer who wants the
            bigger item will buy it somewhere. It is an argument for knowing which lines pay for the freight and which
            ones you are subsidising.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">Cash to enter, before any negotiation</h2>
          <p>
            The lowest cash commitment in this collection is the {lowestCash.id} at roughly $
            {lowestCash.cash.toLocaleString('en-US')} for {lowestCash.moq} pieces; the highest is the {highestCash.id}{' '}
            at about ${highestCash.cash.toLocaleString('en-US')}. Neither figure includes freight or a packaging run.
          </p>
          <p>
            For a school buyer the minimum is usually the obstacle, not the price. That is why institutional purchases
            normally reach the factory through a distributor who can split a carton across several customers — worth
            knowing before you spend a term trying to buy thirty pieces direct.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">Why catalogue buyers need the item number to stay the same</h2>
          <p>
            A school catalogue is reprinted every year and a distributor's customers order from it by reference. If the
            item number behind a listing changes, every reorder has to be re-matched, and the first thing that breaks is
            the price comparison against last year. Stability of the item number is worth more to this buyer than a new
            colour.
          </p>
          <p>
            It also matters for documentation. Test reports, age markings and packaging artwork are tied to a model, not
            to a mood. A model that stays in production keeps its history; a model that is quietly replaced every season
            starts from zero each time, and the buyer pays for that in approval cycles rather than in price.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-display font-bold text-white mb-4 tracking-tight">What to confirm per item number</h2>
          <p>
            Age marking, small parts, battery requirement and the applicable test reports are all item-level facts. They
            are answered per model and per destination market, in writing, with the quotation. None of them can be
            answered honestly for "the educational range" as a whole, and a supplier who offers to is giving you a
            sentence rather than a document.
          </p>
          <p>
            Everything numeric on this page comes from the product records and is published, model by model, on the
            packing dataset.
          </p>
        </section>
      </div>

      <div class="mt-16 border-t border-white/10 pt-12">
        <h2 class="text-2xl font-display font-bold text-white mb-8 tracking-tight">Educational toy questions</h2>
        <div class="space-y-8">
          {faqs.map((f) => (
            <div>
              <h3 class="text-white text-lg font-bold mb-3 tracking-tight">{f.q}</h3>
              <p class="text-gray-400 leading-[1.9]">{f.a}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="bg-[#0F0F14] border border-white/5 p-8 mt-16">
        <span class="text-gold font-bold text-[9px] uppercase tracking-[0.4em] block mb-4">Next step</span>
        <p class="text-gray-300 leading-[1.9] mb-6">
          If you supply schools, work backwards from the term date rather than forwards from your stock level — the
          factory averages twenty days in production, and the sea leg is usually the longer half.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/category/educational-toys" class="bg-gold text-dark font-black px-8 py-4 uppercase tracking-[0.3em] text-[10px] hover:bg-white transition">Educational collection</a>
          <a href="/industries/schools-and-educational-distributors" class="border border-white/15 text-white font-black px-8 py-4 uppercase tracking-[0.3em] text-[10px] hover:border-gold hover:text-gold transition">For schools</a>
          <a href="/packing-data" class="border border-white/15 text-white font-black px-8 py-4 uppercase tracking-[0.3em] text-[10px] hover:border-gold hover:text-gold transition">Packing data</a>
        </div>
      </div>
    </div>
  </article>
</Layout>
