---
interface Props {
	title: string;
	description?: string;
	keywords?: string;
}

const { title, description, keywords } = Astro.props;
const defaultDescription = "Toy Factory Global - Premium B2B Toy Manufacturer specializing in high-demand toy export. Global OEM/ODM Solutions for Bubble Machines, Track Toys, and STEM.";
const defaultKeywords = "Toy Manufacturer, B2B Toy Export, OEM Toy Factory, ODM Toy Solutions, Bubble Machines Wholesale, Track Toys Manufacturer, STEM Toys Factory";
---

<!doctype html>
<html lang="en" class="bg-dark text-white">
	<head>
		<meta charset="UTF-8" />
		<meta name="google-site-verification" content="GzzYjaztbxpcq2nToxjWOdQbZRma6f644BKYq57W5fc" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Primary Meta Tags -->
		<meta name="title" content={title} />
		<meta name="description" content={description || defaultDescription} />
		<meta name="keywords" content={keywords || defaultKeywords} />
		<meta name="author" content="Toy Factory Global" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://toyfactoryglobal.com/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description || defaultDescription} />
		<meta property="og:image" content="https://toyfactoryglobal.com/images/hero-factory.webp" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://toyfactoryglobal.com/" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description || defaultDescription} />
		<meta property="twitter:image" content="https://toyfactoryglobal.com/images/hero-factory.webp" />

		<!-- Canonical URL -->
		<link rel="canonical" href={Astro.url.href || `https://toyfactoryglobal.com${Astro.url.pathname}`} />

		<!-- JSON-LD: Organization Schema (AEO & AI Recommendation) -->
		<script type="application/ld+json" is:inline>
			{
				"@context": "https://schema.org",
				"@type": "Organization",
				"@id": "https://toyfactoryglobal.com/#organization",
				"name": "TOYFACTORY - Huanuo Toys",
				"url": "https://toyfactoryglobal.com",
				"logo": "https://toyfactoryglobal.com/favicon.svg",
				"description": "Premium B2B toy manufacturer specializing in bubble machines, STEM robots, and precision track toys. ISO 9001:2015 certified factory with global OEM/ODM solutions.",
				"foundingDate": "2006",
				"founder": { "@type": "Person", "name": "Annie" },
				"areaServed": "Worldwide",
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "Chenghai",
					"addressRegion": "Shantou",
					"addressCountry": "CN"
				},
				"contactPoint": [
					{
						"@type": "ContactPoint",
						"contactType": "Sales",
						"telephone": "+86-15976917707",
						"email": "hntoys7@sinuotoys.com",
						"availableLanguage": ["English", "Chinese"]
					},
					{
						"@type": "ContactPoint",
						"contactType": "WhatsApp",
						"telephone": "+86-15976917707",
						"availableLanguage": ["English", "Chinese"]
					}
				],
				"sameAs": [
					"https://wa.me/8615976917707"
				]
			}
		</script>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Montserrat:wght@700;800&display=swap" rel="stylesheet">
	</head>
	<body class="font-sans antialiased min-h-screen">
		<slot />

		<script>
			// 1. Disable browser's automatic scroll restoration to ensure it starts at the top
			if ('scrollRestoration' in history) {
				history.scrollRestoration = 'manual';
			}

			// 2. Clear hash on initial load to prevent the browser from jumping to sections
			if (window.location.hash) {
				history.replaceState("", document.title, window.location.pathname + window.location.search);
			}

			// 3. Force scroll to top on every load
			window.scrollTo(0, 0);

			// 4. Smooth scrolling for anchor links without changing URL hash
			document.querySelectorAll('a[href^="#"]').forEach(anchor => {
				anchor.addEventListener('click', function (e) {
					const href = this.getAttribute('href');
					if (href && href.startsWith('#') && href !== '#') {
						e.preventDefault();
						const targetElement = document.querySelector(href);
						if (targetElement) {
							targetElement.scrollIntoView({
								behavior: 'smooth'
							});
						}
					}
				});
			});
		</script>
	</body>
</html>
<style is:global>
	:root {
		--gold: #C9A84C;
	}
	html {
		scroll-behavior: smooth;
		background: #0A0A0F;
	}
	body {
		margin: 0;
		padding: 0;
	}
	/* Custom scrollbar for premium look */
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: #0A0A0F;
	}
	::-webkit-scrollbar-thumb {
		background: #C9A84C;
		border-radius: 4px;
	}
</style>
