---
import { GA4_ID, CLARITY_ID } from '../config/analytics';

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	/** Page-specific structured data (BlogPosting, CollectionPage, BreadcrumbList...). */
	jsonLd?: Record<string, any> | Record<string, any>[];
	/** Set on the 404 page so it never enters the index. */
	noindex?: boolean;
}

const { title, description, keywords, jsonLd, noindex = false } = Astro.props;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const defaultDescription = "Toy Factory Global - Premium B2B Toy Manufacturer specializing in high-demand toy export. Global OEM/ODM Solutions for Bubble Machines, Track Toys, and STEM.";
const defaultKeywords = "Toy Manufacturer, B2B Toy Export, OEM Toy Factory, ODM Toy Solutions, Bubble Machines Wholesale, Track Toys Manufacturer, STEM Toys Factory";

// Canonical URL always resolves to the authoritative non-www domain,
// regardless of whether the page was reached via www or non-www.
// With build.format='file' Astro reports pathname as '/foo.html', but Cloudflare
// Pages serves that file at '/foo' — strip the extension, otherwise the canonical
// tag points at a URL that 308-redirects (which is what blocked indexing).
let canonicalPath = Astro.url.pathname.replace(/\/+$/, '');
if (canonicalPath.endsWith('/index.html')) {
	canonicalPath = canonicalPath.slice(0, -'/index.html'.length);
} else if (canonicalPath.endsWith('.html')) {
	canonicalPath = canonicalPath.slice(0, -'.html'.length);
}
if (!canonicalPath) canonicalPath = '/';
const canonicalURL = `https://toyfactoryglobal.com${canonicalPath}`;
const ogImage = `https://toyfactoryglobal.com${Astro.props.ogImage || '/images/hero-factory.webp'}`;
---

<!doctype html>
<html lang="en" class="bg-dark text-white">
	<head>
		<meta charset="UTF-8" />
		<meta name="google-site-verification" content="GzzYjaztbxpcq2nToxjWOdQbZRma6f644BKYq57W5fc" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Primary Meta Tags -->
		<meta name="title" content={title} />
		<meta name="description" content={description || defaultDescription} />
		<meta name="keywords" content={keywords || defaultKeywords} />
		<meta name="author" content="Toy Factory Global" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description || defaultDescription} />
		<meta property="og:image" content="https://toyfactoryglobal.com/images/hero-factory.webp" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description || defaultDescription} />
		<meta property="twitter:image" content="https://toyfactoryglobal.com/images/hero-factory.webp" />

		<!-- Canonical URL (always non-www authoritative domain) -->
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<!-- Page-level structured data (BlogPosting / CollectionPage / BreadcrumbList) -->
		{jsonLdBlocks.map((block) => (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
		))}

		<!-- JSON-LD: Organization Schema (AEO & AI Recommendation) -->
		<script type="application/ld+json" is:inline>
			{
				"@context": "https://schema.org",
				"@type": "Organization",
				"@id": "https://toyfactoryglobal.com/#organization",
				"name": "TOYFACTORY - Huanuo Toys",
				"url": "https://toyfactoryglobal.com",
				"logo": "https://toyfactoryglobal.com/favicon.svg",
				"description": "Premium B2B toy manufacturer specializing in bubble machines, STEM robots, and precision track toys. ISO 9001:2015 certified factory with global OEM/ODM solutions.",
				"foundingDate": "2001",
				"areaServed": "Worldwide",
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "Chenghai",
					"addressRegion": "Shantou",
					"addressCountry": "CN"
				},
				"contactPoint": [
					{
						"@type": "ContactPoint",
						"contactType": "Sales",
						"name": "Annie",
						"telephone": "+86-15976917707",
						"email": "hntoys7@sinuotoys.com",
						"availableLanguage": ["English", "Chinese"]
					},
					{
						"@type": "ContactPoint",
						"contactType": "WhatsApp",
						"telephone": "+86-15976917707",
						"availableLanguage": ["English", "Chinese"]
					}
				],
				"sameAs": [
					"https://wa.me/8615976917707",
					"https://www.youtube.com/@TOYFACTORYOfficial-m8q"
				]
			}
		</script>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Montserrat:wght@700;800&display=swap" rel="stylesheet">

		<!-- ANALYTICS. Both scripts stay dormant until an ID is pasted into
		     src/config/analytics.ts, so an unconfigured site ships no third-party JS. -->
		{GA4_ID && (
			<>
				<script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} async></script>
				<script is:inline define:vars={{ GA4_ID }}>
					window.dataLayer = window.dataLayer || [];
					function gtag(){ dataLayer.push(arguments); }
					gtag('js', new Date());
					gtag('config', GA4_ID, { anonymize_ip: true });
				</script>
			</>
		)}
		{CLARITY_ID && (
			<script is:inline define:vars={{ CLARITY_ID }}>
				(function(c,l,a,r,i,t,y){
					c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
					t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
					y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
				})(window, document, "clarity", "script", CLARITY_ID);
			</script>
		)}
		{GA4_ID && (
			<script is:inline>
				/* Conversion events. Delegated on document, so it covers every
				   WhatsApp / mailto / tel link on every page without touching markup. */
				document.addEventListener('click', function (e) {
					var a = e.target && e.target.closest ? e.target.closest('a') : null;
					if (!a) return;
					var href = a.getAttribute('href') || '';
					var name = null;
					if (href.indexOf('wa.me') > -1 || href.indexOf('api.whatsapp.com') > -1) name = 'whatsapp_click';
					else if (href.indexOf('mailto:') === 0) name = 'email_click';
					else if (href.indexOf('tel:') === 0) name = 'phone_click';
					if (name && window.gtag) gtag('event', name, { link_url: href, page_path: location.pathname });
				});
				/* Form submits are captured before navigation, so the hit is not lost. */
				document.addEventListener('submit', function (e) {
					var f = e.target;
					if (!f || !f.action) return;
					if (window.gtag) gtag('event', 'form_submit', {
						form_destination: f.action,
						page_path: location.pathname
					});
				});
				if (location.pathname === '/products' && window.gtag) {
					gtag('event', 'catalog_view', { page_path: '/products' });
				}
			</script>
		)}
	</head>
	<body class="font-sans antialiased min-h-screen">
		<slot />

		<script>
			// 1. Disable browser's automatic scroll restoration to ensure it starts at the top
			if ('scrollRestoration' in history) {
				history.scrollRestoration = 'manual';
			}

			// 2. Clear hash on initial load to prevent the browser from jumping to sections
			if (window.location.hash) {
				history.replaceState("", document.title, window.location.pathname + window.location.search);
			}

			// 3. Force scroll to top on every load
			window.scrollTo(0, 0);

			// 4. Smooth scrolling for anchor links without changing URL hash
			document.querySelectorAll('a[href^="#"]').forEach(anchor => {
				anchor.addEventListener('click', function (e) {
					const href = this.getAttribute('href');
					if (href && href.startsWith('#') && href !== '#') {
						e.preventDefault();
						const targetElement = document.querySelector(href);
						if (targetElement) {
							targetElement.scrollIntoView({
								behavior: 'smooth'
							});
						}
					}
				});
			});
		</script>

		<!-- ATTRIBUTION. Fills the hidden fields on every RFQ form with the page,
		     the referrer and the campaign, so each submission that arrives in
		     Formspree already says where it came from. Independent of GA4, which
		     matters because the form log is the fallback when analytics is off. -->
		<script is:inline>
			(function () {
				var params = new URLSearchParams(location.search);
				function fill(name, value) {
					var fields = document.querySelectorAll('input[name="' + name + '"]');
					for (var i = 0; i < fields.length; i++) {
						if (!fields[i].value) fields[i].value = value || '';
					}
				}
				fill('page_path', location.pathname);
				fill('referrer', document.referrer || 'direct');
				fill('utm_source', params.get('utm_source'));
				fill('utm_medium', params.get('utm_medium'));
				fill('utm_campaign', params.get('utm_campaign'));
			})();
		</script>
	</body>
</html>
<style is:global>
	:root {
		--gold: #C9A84C;
	}
	html {
		scroll-behavior: smooth;
		background: #0A0A0F;
	}
	body {
		margin: 0;
		padding: 0;
	}
	/* Custom scrollbar for premium look */
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: #0A0A0F;
	}
	::-webkit-scrollbar-thumb {
		background: #C9A84C;
		border-radius: 4px;
	}
</style>
