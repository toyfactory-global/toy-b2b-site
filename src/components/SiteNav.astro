---
// Shared header for the standalone trust pages (/factory, /oem-odm, /about).
// Existing pages keep their own inline navs; this exists so new pages stay
// consistent without touching 40+ files.
interface Props {
  active?: string;
}
const { active = '' } = Astro.props;
const links = [
  { href: '/products', label: 'Catalogue', key: 'products' },
  { href: '/factory', label: 'Factory', key: 'factory' },
  { href: '/oem-odm', label: 'OEM / ODM', key: 'oem' },
  { href: '/about', label: 'About', key: 'about' },
  { href: '/blog', label: 'Guides', key: 'blog' },
  { href: '/contact', label: 'Contact', key: 'contact' },
];
const WA = 'https://api.whatsapp.com/send/?phone=8615976917707&text=Hello%20TOYFACTORY%2C%20I%27d%20like%20a%20quotation.&type=phone_number&app_absent=0';
---

<nav class="fixed w-full z-50 bg-[#0A0A0F]/90 backdrop-blur-xl border-b border-white/5">
  <div class="max-w-[1600px] mx-auto px-8 h-24 flex items-center justify-between">
    <a href="/" class="text-2xl font-display font-extrabold tracking-tighter text-white">
      TOY<span class="text-gold">FACTORY</span>
    </a>
    <div class="hidden lg:flex gap-8 text-[11px] font-bold uppercase tracking-[0.2em] text-gray-400">
      {links.map((l) => (
        <a href={l.href} class={active === l.key ? 'text-gold' : 'hover:text-gold transition-colors'}>{l.label}</a>
      ))}
    </div>
    <a href={WA} target="_blank" rel="noopener" class="bg-gold text-dark px-6 py-4 font-bold uppercase text-[10px] tracking-widest hover:bg-white transition-all duration-300">
      WhatsApp
    </a>
  </div>
</nav>
